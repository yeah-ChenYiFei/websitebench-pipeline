{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbench.local/schemas/offline-clone.semantic-selection.v2.json",
  "title": "Human-gated semantic selection for a full-stack clone candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site_id", "selection_id", "candidate_identity_sha256", "source_scope_sha256", "frontend_subject", "source_scope_subject", "generated_at", "capabilities", "human_gate", "authority"],
  "properties": {
    "schema_version": {"const": "offline-clone.semantic-selection.v2"},
    "site_id": {"$ref": "#/$defs/slug"},
    "selection_id": {"$ref": "#/$defs/id"},
    "candidate_identity_sha256": {"$ref": "#/$defs/sha256"},
    "source_scope_sha256": {"$ref": "#/$defs/sha256"},
    "frontend_subject": {"$ref": "#/$defs/subject"},
    "source_scope_subject": {"$ref": "#/$defs/subject"},
    "generated_at": {"type": "string", "format": "date-time"},
    "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
    "human_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unresolved_capability_ids"],
      "properties": {
        "status": {"enum": ["pending", "blocked", "passed"]},
        "unresolved_capability_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "authority": {"const": "human-semantic-selection-only-cannot-accept-fidelity-or-release"}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 200},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._:-][a-z0-9]+)*$", "maxLength": 300},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "subject_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": {"enum": ["file", "tree"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity_sha256", "artifacts"],
      "properties": {
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject_artifact"}}
      }
    },
    "human_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_id", "decider", "decided_at", "candidate_identity_sha256", "source_scope_sha256", "rationale"],
      "properties": {
        "decision_id": {"$ref": "#/$defs/id"},
        "decider": {"type": "string", "minLength": 1, "maxLength": 200},
        "decided_at": {"type": "string", "format": "date-time"},
        "candidate_identity_sha256": {"$ref": "#/$defs/sha256"},
        "source_scope_sha256": {"$ref": "#/$defs/sha256"},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "applicable", "certainty", "mandatory_when_applicable", "trigger", "evidence_refs", "disposition", "decision_source", "rationale", "human_decision"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "priority": {"enum": ["p0", "p1", "p2"]},
        "applicable": {"type": "boolean"},
        "certainty": {"enum": ["determinate", "ambiguous"]},
        "mandatory_when_applicable": {"type": "boolean"},
        "trigger": {"enum": ["source-visible", "core-purpose", "archetype-required", "common-stateful-core", "inferred-ambiguous"]},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 1000}},
        "disposition": {"enum": ["full-local-model", "truthful-simulation", "excluded-with-rationale", "external-blocked", "unresolved"]},
        "decision_source": {"enum": ["mechanical", "human"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4000},
        "human_decision": {"oneOf": [{"$ref": "#/$defs/human_decision"}, {"type": "null"}]}
      }
    }
  }
}
