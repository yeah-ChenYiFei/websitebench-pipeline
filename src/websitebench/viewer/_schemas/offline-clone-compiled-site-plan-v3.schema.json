{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://websitebench.local/schemas/offline-clone.compiled-site-plan.v3.json",
  "title": "Deterministic compiled offline-clone site plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "target",
    "site_ir",
    "evidence_boundary",
    "workflow",
    "artifact_graph"
  ],
  "properties": {
    "schema_version": {
      "const": "offline-clone.compiled-site-plan.v3"
    },
    "compiler_version": {
      "const": "websitebench.site-compiler.v3"
    },
    "target": {
      "enum": [
        "scope",
        "frontend",
        "backend",
        "release"
      ]
    },
    "site_ir": {
      "type": "object"
    },
    "evidence_boundary": {
      "type": "object"
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordered_stages",
        "target",
        "automation_policy",
        "backend_policy"
      ],
      "properties": {
        "ordered_stages": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "inventory-normalization",
              "profile-and-pack-resolution",
              "scope-validation",
              "source-capture-and-asset-closure",
              "frontend-convergence",
              "frontend-validation",
              "persistent-backend",
              "semantic-validation",
              "harbor-machine-evidence",
              "release-validation"
            ]
          }
        },
        "target": {
          "enum": [
            "scope",
            "frontend",
            "backend",
            "release"
          ]
        },
        "automation_policy": {
          "type": "string",
          "minLength": 1
        },
        "backend_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact_graph": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "kind",
          "invalidates_from",
          "input_ids",
          "payload"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "invalidates_from": {
            "enum": [
              "scope-validation",
              "frontend-validation",
              "semantic-validation",
              "release-validation"
            ]
          },
          "input_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "payload": {}
        }
      }
    }
  }
}
