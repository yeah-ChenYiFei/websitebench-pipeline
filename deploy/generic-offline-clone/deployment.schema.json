{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbench.local/schemas/generic-public-clone-deployment.v1.json",
  "title": "Generic protected public deployment for one offline clone",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site_id", "site_label", "domain", "source_dir", "runtime", "cloudflare"],
  "properties": {
    "schema_version": {"const": "clawbench.generic-public-clone-deployment.v1"},
    "site_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "site_label": {"type": "string", "minLength": 1, "maxLength": 120},
    "domain": {"type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,63}$"},
    "source_dir": {"$ref": "#/$defs/path"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "port", "health_path", "auth_mode", "python_requirements", "support_paths"],
      "properties": {
        "command": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
        "port": {"const": 10000},
        "health_path": {"type": "string", "pattern": "^/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$", "maxLength": 300},
        "auth_mode": {"enum": ["local", "redis-resend"]},
        "python_requirements": {"type": "array", "maxItems": 100, "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+(?:\\[[A-Za-z0-9_,.-]+\\])?==[A-Za-z0-9_.+!-]+$"}},
        "support_paths": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "destination"],
            "properties": {
              "source": {"$ref": "#/$defs/path"},
              "destination": {"$ref": "#/$defs/path"}
            }
          }
        }
      }
    },
    "cloudflare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker_name", "compatibility_date", "instance_type", "max_instances"],
      "properties": {
        "worker_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 63},
        "compatibility_date": {"type": "string", "format": "date"},
        "instance_type": {"enum": ["dev", "basic", "standard"]},
        "max_instances": {"type": "integer", "minimum": 1, "maximum": 10}
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
