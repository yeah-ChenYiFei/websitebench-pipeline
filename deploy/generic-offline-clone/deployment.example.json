{
  "schema_version": "clawbench.generic-public-clone-deployment.v1",
  "site_id": "taskrabbit",
  "site_label": "Taskrabbit Clone",
  "domain": "taskrabbit.example.com",
  "source_dir": "materials/taskrabbit/clone",
  "runtime": {
    "command": ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "10000", "--log-level", "warning"],
    "port": 10000,
    "health_path": "/healthz",
    "auth_mode": "local",
    "python_requirements": [
      "argon2-cffi==25.1.0",
      "fastapi==0.139.2",
      "jinja2==3.1.6",
      "python-multipart==0.0.32",
      "uvicorn==0.51.0"
    ],
    "support_paths": []
  },
  "cloudflare": {
    "worker_name": "websitebench-taskrabbit-demo",
    "compatibility_date": "2026-07-30",
    "instance_type": "basic",
    "max_instances": 1
  }
}
