{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://websitebench.local/schemas/offline-clone.source-acquisition-spec.v2.json",
  "title": "Configuration-scoped source acquisition specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "site_id", "capture_id", "allowed_origins", "pages", "limits"],
  "properties": {
    "schema_version": {"const": "offline-clone.source-acquisition-spec.v2"},
    "site_id": {"$ref": "#/$defs/slug"},
    "capture_id": {"$ref": "#/$defs/id"},
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri", "maxLength": 2000}
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/page"}
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["navigation_timeout_ms", "settle_ms", "max_resource_bytes", "max_total_resource_bytes"],
      "properties": {
        "navigation_timeout_ms": {"type": "integer", "minimum": 1000, "maximum": 120000},
        "settle_ms": {"type": "integer", "minimum": 0, "maximum": 30000},
        "max_resource_bytes": {"type": "integer", "minimum": 1024, "maximum": 52428800},
        "max_total_resource_bytes": {"type": "integer", "minimum": 1024, "maximum": 1073741824}
      }
    }
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 200},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$", "maxLength": 300},
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "priority", "url", "viewport"],
      "properties": {
        "row_id": {"$ref": "#/$defs/id"},
        "priority": {"enum": ["p0", "p1", "p2"]},
        "url": {"type": "string", "format": "uri", "maxLength": 4000},
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "width", "height"],
          "properties": {
            "name": {"$ref": "#/$defs/id"},
            "width": {"type": "integer", "minimum": 320, "maximum": 3840},
            "height": {"type": "integer", "minimum": 320, "maximum": 2160}
          }
        },
        "wait_until": {"enum": ["commit", "domcontentloaded", "load", "networkidle"], "default": "networkidle"},
        "full_page": {"type": "boolean", "default": true}
      }
    }
  }
}
