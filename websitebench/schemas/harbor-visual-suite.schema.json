{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://websitebench.local/schemas/harbor-visual-suite.schema.json",
  "title": "WebsiteBench Harbor deterministic visual suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "site_id", "checkpoints"],
  "properties": {
    "schema_version": {"const": "websitebench.harbor.visual-suite.v1"},
    "suite_id": {"$ref": "#/$defs/id"},
    "site_id": {"$ref": "#/$defs/id"},
    "checkpoints": {"type": "array", "minItems": 0, "maxItems": 200, "items": {"$ref": "#/$defs/checkpoint"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$", "maxLength": 160},
    "relative_path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+"},
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "oneOf": [
        {"required": ["role"]},
        {"required": ["label"]},
        {"required": ["text"]},
        {"required": ["test_id"]},
        {"required": ["css"]}
      ],
      "properties": {
        "role": {"type": "string", "minLength": 1, "maxLength": 40},
        "name": {"type": "string", "maxLength": 500},
        "label": {"type": "string", "maxLength": 500},
        "text": {"type": "string", "maxLength": 2000},
        "test_id": {"type": "string", "maxLength": 200},
        "css": {"type": "string", "maxLength": 1000},
        "nth": {"type": "integer", "minimum": 0}
      },
      "dependentRequired": {"name": ["role"]}
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {"enum": ["goto", "click", "fill", "type", "select", "press", "upload", "reload", "new_actor", "use_actor", "mailbox_code", "restart", "wait_for", "api"]},
        "selector": {"$ref": "#/$defs/selector"},
        "value": {"type": ["string", "number", "boolean"]},
        "path": {"type": "string", "maxLength": 2048},
        "fixture": {"$ref": "#/$defs/relative_path"},
        "actor": {"$ref": "#/$defs/id"},
        "capture_as": {"$ref": "#/$defs/id"},
        "timeout_ms": {"type": "integer", "minimum": 1, "maximum": 120000},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]},
        "body": {},
        "download": {"type": "boolean"},
        "json_pointer": {"type": "string", "maxLength": 2048},
        "state": {"enum": ["attached", "detached", "visible", "hidden"]}
      },
      "allOf": [
        {"if": {"properties": {"op": {"enum": ["click", "fill", "type", "select", "press", "upload", "wait_for"]}}}, "then": {"required": ["selector"]}},
        {"if": {"properties": {"op": {"const": "upload"}}}, "then": {"required": ["fixture"]}},
        {"if": {"properties": {"op": {"enum": ["new_actor", "use_actor"]}}}, "then": {"required": ["actor"]}},
        {"if": {"properties": {"op": {"const": "mailbox_code"}}}, "then": {"required": ["capture_as", "value"]}}
      ]
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rect"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "rect": {"$ref": "#/$defs/rect"},
        "masks": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/rect"}}
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "viewport", "timeout_sec", "actions", "regions", "reference_image"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "route": {"type": "string", "pattern": "^/(?!/)", "maxLength": 2048},
        "timeout_sec": {"type": "integer", "minimum": 1, "maximum": 300},
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 320, "maximum": 7680},
            "height": {"type": "integer", "minimum": 240, "maximum": 4320}
          }
        },
        "actions": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/action"}},
        "reference_mutation_authorized": {"const": true},
        "regions": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/region"}},
        "reference_image": {"$ref": "#/$defs/relative_path"}
      }
    }
  }
}
