{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbench.local/schemas/webcloning.exploration-coverage.v1.json",
  "title": "Trace-guided clone exploration coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "coverage_id",
    "site_id",
    "bundles",
    "clone_traces",
    "rows",
    "counts",
    "architecture",
    "status",
    "authority",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {"const": "webcloning.exploration-coverage.v1"},
    "coverage_id": {"$ref": "#/$defs/sha256"},
    "site_id": {"$ref": "#/$defs/id"},
    "bundles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "clone_traces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matched", "missing", "conflicting", "unavailable"],
      "properties": {
        "matched": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "conflicting": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inferred", "conflicting", "unavailable"],
      "properties": {
        "inferred": {"type": "integer", "minimum": 0},
        "conflicting": {"type": "integer", "minimum": 0},
        "unavailable": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["complete", "incomplete", "historical-stale"]},
    "authority": {
      "const": "mechanical-exploration-coverage-only-cannot-accept-fidelity-or-release"
    },
    "content_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "trace_sha256",
        "step_id",
        "route",
        "observable_sha256",
        "action_family",
        "target",
        "observation_kinds",
        "structure_sha256",
        "request_semantics_sha256",
        "evidence_kind",
        "disposition"
      ],
      "properties": {
        "row_id": {"$ref": "#/$defs/sha256"},
        "trace_sha256": {"$ref": "#/$defs/sha256"},
        "step_id": {"type": "string", "pattern": "^s[0-9]{4,}$"},
        "route": {"type": ["string", "null"], "maxLength": 2000},
        "observable_sha256": {"$ref": "#/$defs/sha256"},
        "action_family": {"type": "string", "minLength": 1, "maxLength": 80},
        "target": {"type": ["string", "null"], "maxLength": 2000},
        "observation_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "structure_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "request_semantics_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "evidence_kind": {"enum": ["current-direct", "historical"]},
        "disposition": {
          "enum": ["matched", "missing", "conflicting", "unavailable"]
        }
      }
    }
  }
}
