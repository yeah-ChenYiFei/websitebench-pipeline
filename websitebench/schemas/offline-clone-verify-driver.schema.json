{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://websitebench.local/schemas/offline-clone-verify-driver.schema.json",
  "title": "WebsiteBench offline clone diagnostic driver",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": "offline-clone.verify-driver.v1"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "note": {
      "type": "string",
      "maxLength": 32768
    },
    "routes": {
      "$ref": "#/$defs/routeMap"
    },
    "deferred": {
      "$ref": "#/$defs/reasonMap"
    },
    "visual_excluded": {
      "$ref": "#/$defs/reasonMap"
    },
    "states_out_of_scope": {
      "$ref": "#/$defs/reasonMap"
    },
    "status": {
      "type": "object",
      "maxProperties": 2048,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 100,
        "maximum": 599
      }
    },
    "prepare": {
      "$ref": "#/$defs/steps"
    },
    "states": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/$defs/steps"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "steps"
            ],
            "properties": {
              "session": {
                "$ref": "#/$defs/id"
              },
              "steps": {
                "$ref": "#/$defs/steps"
              }
            }
          }
        ]
      }
    },
    "session": {
      "$ref": "#/$defs/session"
    },
    "boot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^\\u0000\\r\\n]+$"
          }
        },
        "cwd": {
          "enum": [
            ".",
            "clone"
          ]
        },
        "env": {
          "$ref": "#/$defs/stringMap"
        },
        "read_paths": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[^/][^\\u0000]*$"
          },
          "description": "Site-relative trees the candidate reads at runtime from beside clone/ rather than beneath it. The sandbox mounts the candidate root plus backend/ and scope/; anything else a runtime legitimately consumes is declared here and resolved inside the site root."
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^/(?!/)[^\\u0000\\r\\n\\\\]*$"
    },
    "routeMap": {
      "type": "object",
      "maxProperties": 2048,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/route"
      }
    },
    "reasonMap": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 8192
      }
    },
    "stringMap": {
      "type": "object",
      "maxProperties": 128,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "goto": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^/",
          "description": "Navigate to this clone-relative path. For a state that lives at its own URL -- a wizard step, a query that produces the empty result -- rather than being clicked to from the checkpoint's base path."
        },
        "click": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "fill": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "expect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "press": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "eval": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        },
        "value": {
          "type": "string",
          "maxLength": 16384
        },
        "optional": {
          "type": "boolean"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30000
        },
        "wait_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      },
      "oneOf": [
        {
          "required": [
            "goto"
          ]
        },
        {
          "required": [
            "click"
          ]
        },
        {
          "required": [
            "fill"
          ]
        },
        {
          "required": [
            "expect"
          ]
        },
        {
          "required": [
            "press"
          ]
        },
        {
          "required": [
            "eval"
          ]
        }
      ]
    },
    "steps": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "form": {
          "$ref": "#/$defs/stringMap"
        },
        "headers": {
          "$ref": "#/$defs/stringMap"
        },
        "routes": {
          "type": "array",
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "session": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "post"
      ],
      "properties": {
        "token_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,95}$"
        },
        "post": {
          "$ref": "#/$defs/route"
        },
        "headers": {
          "$ref": "#/$defs/stringMap"
        },
        "form": {
          "$ref": "#/$defs/stringMap"
        },
        "routes": {
          "type": "array",
          "maxItems": 2048,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "expect_status": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          }
        },
        "env": {
          "$ref": "#/$defs/stringMap"
        },
        "accounts": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "$ref": "#/$defs/account"
          }
        }
      }
    }
  }
}
