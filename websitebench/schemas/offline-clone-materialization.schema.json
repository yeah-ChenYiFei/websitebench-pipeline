{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbench.local/schemas/offline-clone.materialization.v1.json",
  "title": "Atomic materialization record for a compiled site profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler_version",
    "site_id",
    "stage",
    "status",
    "input_identity",
    "producer_stage_packet_sha256",
    "evidence_boundary",
    "emitted_files",
    "forbidden_at_this_stage"
  ],
  "properties": {
    "schema_version": {"const": "offline-clone.materialization.v1"},
    "compiler_version": {"const": "clawbench.site-compiler.v1"},
    "site_id": {"$ref": "#/$defs/id"},
    "stage": {"const": "r1-draft"},
    "status": {"const": "draft-not-reviewed"},
    "input_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["compiled_plan_sha256", "profile_sha256", "inventory_sha256", "resolved_ir_sha256"],
      "properties": {
        "compiled_plan_sha256": {"$ref": "#/$defs/sha256"},
        "profile_sha256": {"$ref": "#/$defs/sha256"},
        "inventory_sha256": {"$ref": "#/$defs/sha256"},
        "resolved_ir_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "producer_stage_packet_sha256": {"$ref": "#/$defs/sha256"},
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "generated_source_claims", "candidate_as_source_truth"],
      "properties": {
        "classification": {"const": "inferred-requires-r1-confirmation"},
        "generated_source_claims": {"const": "forbidden"},
        "candidate_as_source_truth": {"const": "forbidden"}
      }
    },
    "emitted_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/path"},
          "role": {"enum": ["harness", "planned-obligation", "compiler-identity", "producer-stage-packet"]},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "forbidden_at_this_stage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "frozen-source-contract",
          "source-direct-claims",
          "persistent-business-runtime",
          "vendored-auth-runtime",
          "reviewer-decision",
          "harbor-release-evidence"
        ]
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._<>/-]+$"
    }
  }
}
