{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbench.local/schemas/offline-clone.source-acquisition-report.v1.json",
  "title": "Capture-provider-neutral source and media acquisition report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "capture_id",
    "capture_provider",
    "source_scope_sha256",
    "started_at",
    "finished_at",
    "safety",
    "concurrency",
    "pages",
    "resources",
    "closure",
    "blockers",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "offline-clone.source-acquisition-report.v1"},
    "site_id": {"$ref": "#/$defs/slug"},
    "capture_id": {"$ref": "#/$defs/id"},
    "capture_provider": {"enum": ["chrome-mcp", "playwright"]},
    "source_scope_sha256": {"$ref": "#/$defs/sha256"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "anonymous", "mutations_performed", "bypass_attempted"],
      "properties": {
        "methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"const": "GET"}
        },
        "anonymous": {"const": true},
        "mutations_performed": {"const": false},
        "bypass_attempted": {"const": false}
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_download_jobs", "per_origin_download_jobs", "per_origin_page_jobs", "adaptive_backoff"],
      "properties": {
        "global_download_jobs": {"type": "integer", "minimum": 1, "maximum": 16},
        "per_origin_download_jobs": {"type": "integer", "minimum": 1, "maximum": 6},
        "per_origin_page_jobs": {"type": "integer", "minimum": 1, "maximum": 3},
        "adaptive_backoff": {"const": true}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/page"}
    },
    "resources": {"$ref": "#/$defs/resources"},
    "closure": {"$ref": "#/$defs/closure"},
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "authority": {"const": "producer-acquisition-only-cannot-sign-checkpoint-or-release"}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 200},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$", "maxLength": 300},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "bytes"],
      "properties": {
        "kind": {"enum": ["screenshot", "dom", "geometry", "computed-style", "visible-text", "network", "resource-inventory"]},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "priority", "requested_url", "final_url", "status", "viewports", "artifacts"],
      "properties": {
        "row_id": {"$ref": "#/$defs/id"},
        "priority": {"enum": ["p0", "p1", "p2"]},
        "requested_url": {"type": "string", "format": "uri"},
        "final_url": {"type": "string", "format": "uri"},
        "status": {"enum": ["captured", "source-limited", "blocked", "failed"]},
        "viewports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_required", "downloaded", "verified", "referenced", "browser_requested", "physical_file_count", "missing_required_ids"],
      "properties": {
        "logical_required": {"type": "integer", "minimum": 0},
        "downloaded": {"type": "integer", "minimum": 0},
        "verified": {"type": "integer", "minimum": 0},
        "referenced": {"type": "integer", "minimum": 0},
        "browser_requested": {"type": "integer", "minimum": 0},
        "physical_file_count": {"type": "integer", "minimum": 0},
        "missing_required_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "runtime_remote_request_count", "broken_asset_count", "unresolved_css_reference_count"],
      "properties": {
        "status": {"enum": ["complete", "blocked", "in-progress"]},
        "runtime_remote_request_count": {"type": "integer", "minimum": 0},
        "broken_asset_count": {"type": "integer", "minimum": 0},
        "unresolved_css_reference_count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
