{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clawbench.local/schemas/offline-clone.source-acquisition-report.v2.json",
  "title": "Executed human-supervised source acquisition report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "capture_id",
    "capture_provider",
    "source_scope_sha256",
    "started_at",
    "finished_at",
    "safety",
    "concurrency",
    "pages",
    "resources",
    "closure",
    "blockers",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "offline-clone.source-acquisition-report.v2"},
    "site_id": {"$ref": "#/$defs/slug"},
    "capture_id": {"$ref": "#/$defs/id"},
    "capture_provider": {"const": "playwright-chrome"},
    "source_scope_sha256": {"$ref": "#/$defs/sha256"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "anonymous", "mutations_performed", "bypass_attempted", "isolated_context_per_page"],
      "properties": {
        "methods": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"const": "GET"}},
        "anonymous": {"const": true},
        "mutations_performed": {"const": false},
        "bypass_attempted": {"const": false},
        "isolated_context_per_page": {"const": true}
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_download_jobs", "per_origin_download_jobs", "per_origin_page_jobs", "adaptive_backoff"],
      "properties": {
        "global_download_jobs": {"const": 1},
        "per_origin_download_jobs": {"const": 1},
        "per_origin_page_jobs": {"const": 1},
        "adaptive_backoff": {"const": false}
      }
    },
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
    "resources": {"$ref": "#/$defs/resources"},
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failed_request_count", "broken_resource_count", "unresolved_css_reference_count", "blocked_mutation_request_count"],
      "properties": {
        "status": {"enum": ["complete", "blocked", "in-progress"]},
        "failed_request_count": {"type": "integer", "minimum": 0},
        "broken_resource_count": {"type": "integer", "minimum": 0},
        "unresolved_css_reference_count": {"type": "integer", "minimum": 0},
        "blocked_mutation_request_count": {"type": "integer", "minimum": 0}
      }
    },
    "blockers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 2000}},
    "authority": {"const": "human-supervised-source-acquisition-only-cannot-accept-fidelity-or-release"}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 200},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$", "maxLength": 300},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?![A-Za-z]:|/|\\\\|.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "bytes"],
      "properties": {
        "kind": {"enum": ["screenshot", "dom", "geometry", "computed-style", "visible-text", "network", "resource-inventory"]},
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_id", "priority", "requested_url", "final_url", "status", "viewports", "artifacts"],
      "properties": {
        "row_id": {"$ref": "#/$defs/id"},
        "priority": {"enum": ["p0", "p1", "p2"]},
        "requested_url": {"type": "string", "format": "uri"},
        "final_url": {"type": "string", "format": "uri"},
        "status": {"enum": ["captured", "source-limited", "blocked", "failed"]},
        "viewports": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_required", "downloaded", "verified", "referenced", "browser_requested", "physical_file_count", "missing_required_ids"],
      "properties": {
        "logical_required": {"type": "integer", "minimum": 0},
        "downloaded": {"type": "integer", "minimum": 0},
        "verified": {"type": "integer", "minimum": 0},
        "referenced": {"type": "integer", "minimum": 0},
        "browser_requested": {"type": "integer", "minimum": 0},
        "physical_file_count": {"type": "integer", "minimum": 0},
        "missing_required_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  }
}
