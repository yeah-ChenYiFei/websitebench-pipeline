{
  "backend": {
    "capability_templates": [
      {
        "category": "communication",
        "entities": [
          {
            "identity": "site-local opaque conversation identity; exact source key and ownership require R1 confirmation",
            "name": "conversation",
            "owner_scope": "account",
            "persistence": "durable"
          }
        ],
        "external_effect": "none",
        "id": "messaging-realtime-lifecycle",
        "label": "messaging-realtime lifecycle",
        "priority": "p0",
        "server_authorities": [
          "participant authorization",
          "ordered messages",
          "dedupe",
          "disconnect recovery"
        ],
        "state_machine": {
          "kind": "entity-lifecycle",
          "states": [
            "open",
            "active",
            "archived",
            "blocked"
          ],
          "transitions": [
            {
              "from": "open",
              "to": "active",
              "trigger": "server-authorized messaging-realtime lifecycle transition; exact source preconditions must be confirmed and frozen at R1"
            },
            {
              "from": "active",
              "to": "archived",
              "trigger": "server-authorized messaging-realtime lifecycle transition; exact source preconditions must be confirmed and frozen at R1"
            },
            {
              "from": "archived",
              "to": "blocked",
              "trigger": "server-authorized messaging-realtime lifecycle transition; exact source preconditions must be confirmed and frozen at R1"
            }
          ]
        }
      }
    ],
    "local_external_adapters": [
      "local-message-log"
    ]
  },
  "batch_family_id": null,
  "conflicts": [],
  "extension_points": [
    "backend.capabilities"
  ],
  "frontend": {
