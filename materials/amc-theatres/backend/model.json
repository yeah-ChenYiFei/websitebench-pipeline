        {
          "name": "local-account",
          "identity": "nullable concealed account binding",
          "owner_scope": "account",
          "persistence": "durable"
        }
      ],
      "state_machine": {
        "kind": "challenge-lifecycle",
        "states": [
          "requested",
          "verified",
          "consumed",
          "expired",
