        "not_applicable": [
          {"obligation": "duplicate", "rationale": "A later reset request replaces the same session-owned challenge rather than creating a duplicate durable business entity."},
          {"obligation": "concurrency", "rationale": "Password recovery is intentionally serialized per session and account challenge; concurrency is not part of the public recovery contract."}
        ]
