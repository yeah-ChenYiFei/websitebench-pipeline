{
  "schema_version": "websitebench.site.v1",
  "site_id": "craigslist",
  "display_name": "Craigslist (Toronto housing offline clone)",
  "site_version": "0.1.0",
  "family_id": "craigslist",
  "split": "validation",
  "difficulty": "hard",
  "description": "Classified-advertisements platform: browse/search/filter housing by region and category; inspect listing details and reply; post and manage classifieds through a multi-step wizard; account registration (5-minute per-email rate limit), sign-in, password recovery; favorites and saved searches; help/contact; branded not-found. Pure-English interface, fully offline, deterministic seed.",
  "taxonomy": {
    "product_type": "classifieds",
    "capability_tags": ["search", "filter", "posting", "auth", "session", "persistence", "uploads", "mail-outbox"],
    "interaction_tags": ["wizard", "gallery", "forms", "validation", "grid-list", "pagination"],
    "roles": ["public-visitor", "poster", "housing-seeker"],
    "stateful_entities": ["account", "session", "posting", "posting-photo", "favorite", "saved-search", "reply-message", "flag"]
  },
  "public": {
    "prd": "PRD.md",
    "candidate_contract": "candidate-contract.md",
    "task_schema": "benchmark/task-schema.json",
    "fixture_schema": "benchmark/fixture-schema.json",
    "admin_contract_schema": "benchmark/admin-contract-schema.json",
    "visual_checkpoints": "benchmark/visual-checkpoints.json",
    "smoke_cases": "benchmark/smoke-cases.json",
    "scoring": "benchmark/scoring.json",
    "report_schema": "benchmark/report-schema.json"
  },
  "services": {
    "public_port": 8080,
    "admin_port": 8081,
    "health_path": "/healthz",
    "mailbox_delivery_path": "/__admin/mail/deliver",
    "mailbox_query_path": "/__admin/mail/query"
  },
  "routes": [
    "/",
    "/toronto/",
    "/toronto/housing/",
    "/toronto/housing/sub/",
    "/toronto/housing/apa/",
    "/toronto/housing/roo/",
    "/toronto/housing/rea/",
    "/toronto/search/housing",
    "/toronto/search/housing/sub",
    "/toronto/housing/sub/d/1000001/1br-near-annex-furnished-sublet-jul-aug",
    "/toronto/housing/reply/1000001",
    "/post/",
    "/account/login",
    "/account/register",
    "/account/forgot",
    "/account/home",
    "/account/saved",
    "/account/searches",
    "/about/help",
    "/contact"
  ],
  "seeds": {
    "public": [
      {"id": 0, "purpose": "deterministic toronto housing catalog + fixtures", "fixture": "backend/seed/catalog.json"},
      {"id": 1, "purpose": "seeded accounts poster@example.com and seeker@example.com", "fixture": "backend/seed/accounts.json"}
    ],
    "hidden": [
      {"id": 2, "purpose": "canonical sublet fixture for the posting task", "fixture": "benchmark/fixtures/canonical-sublet.json"}
    ],
    "concurrency": [
      {"id": 3, "purpose": "dual-account isolation and ownership fixtures", "fixture": "benchmark/fixtures/concurrency.json"}
    ]
  },
  "tracks": {
    "core": {"enabled": true, "human_messages": 0, "human_minutes": 0, "human_file_edits": false},
    "hitl": {"enabled": true, "human_messages": 6, "human_minutes": 90, "human_file_edits": true}
  },
  "agent_budget": {
    "wall_time_seconds": 21600,
    "token_budget": 2000000,
    "browser_actions": 800,
    "candidate_builds": 12
  },
  "pilot_agent": {
    "harness": "codex",
    "model": "gpt-5.6",
    "thinking_level": "high"
  },
  "browser_policy": {
    "engine": "browser-use",
    "version": "1.x",
    "reference_access": "continuous",
    "allowed": ["accessibility-tree", "page-semantics", "screenshot", "form-interaction", "navigation"],
    "denied": ["source-map", "js-bundle-download", "browser-cache-read", "network-body-inspection", "file-download"]
  },
  "license": {
    "code": "Apache-2.0 (repository-owned code); the clone's own implementation is original work.",
    "content": "All page copy in the clone is original benchmark text; no craigslist content is reproduced.",
    "assets": "All images, fonts, icons, and styles are locally authored synthetic assets; no craigslist assets are redistributed.",
    "trademarks": "The 'craigslist' name and look are used solely as the benchmark target identity for evaluation; no affiliation, endorsement, or redistribution license is claimed. Redistribution of the clone's visual identity is not authorized."
  }
}
