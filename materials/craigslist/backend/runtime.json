{
  "database": {
    "data_dir": "data",
    "engine": "sqlite",
    "filename": "craigslist.sqlite3",
    "legacy_unbound_migration": false,
    "migration_hook": null,
    "seed_hook": null
  },
  "deployment": {
    "profiles": {
      "cloudflare-review": {
        "mail_adapter": "redis-resend",
        "payment_adapter": "local-sandbox",
        "persistence": "ephemeral-reset"
      },
      "docker-volume": {
        "mail_adapter": "effects-gateway",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent-volume"
      },
      "offline-harbor": {
        "mail_adapter": "local-outbox",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent"
      }
    }
  },
  "mail": {
    "purposes": {
      "password-reset": {
        "body": "Your password reset code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "Ignore this message if you did not contact Craigslist (offline clone).",
        "lead": "A password reset was requested for Craigslist (offline clone).",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ],
        "subject": "Reset your Craigslist (offline clone) password",
        "template_id": "craigslist.password-reset.v1"
      },
      "registration": {
        "body": "Your verification code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "This code is only for Craigslist (offline clone).",
        "lead": "Finish creating your Craigslist (offline clone) account.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ],
        "subject": "Verify your Craigslist (offline clone) account",
        "template_id": "craigslist.registration.v1"
      },
      "posting-reply": {
        "body": "${sender_name} (${sender_email}) replied to your posting \"${posting_title}\" (#${posting_id}).",
        "expiry": "Reply messages are delivered to the local outbox only.",
        "footer": "Craigslist (offline clone) — no real email was sent.",
        "lead": "You have a new reply to your Craigslist posting.",
        "required_variables": [
          "sender_name",
          "sender_email",
          "posting_title",
          "posting_id"
        ],
        "secret_variables": [],
        "subject": "New reply to your Craigslist posting",
        "template_id": "craigslist.posting-reply.v1"
      }
    },
    "sender": {
      "address_env": "RESEND_FROM_EMAIL",
      "display_name": "Craigslist (offline clone)"
    }
  },
  "payments": {
    "currency": "USD",
    "default_adapter": "local-sandbox",
    "local_sandbox": {
      "scenarios": [
        {
          "display_label": "Simulated approval",
          "id": "sandbox-approved",
          "outcome": "approved"
        },
        {
          "display_label": "Simulated decline",
          "id": "sandbox-declined",
          "outcome": "declined"
        },
        {
          "display_label": "Simulated retry",
          "id": "sandbox-retry",
          "outcome": "retryable"
        }
      ]
    },
    "stripe_test": null
  },
  "schema_version": "websitebench.site-backend-runtime.v1",
  "session": {
    "host_only": true,
    "http_only": true,
    "same_site": "Lax",
    "secure": true
  },
  "site": {
    "id": "craigslist",
    "label": "Craigslist (offline clone)",
    "public_origin": "https://craigslist.offline.invalid"
  }
}
