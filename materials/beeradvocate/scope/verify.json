{
  "schema_version": "offline-clone.verify-driver.v1",
  "site_id": "beeradvocate",
  "note": "Anonymous checkpoints use direct clone paths. The review-form checkpoint uses the explicitly gated diagnostic session endpoint; authenticated source submission remains unavailable.",
  "routes": {
    "home": "/",
    "beers": "/beer/",
    "search": "/search/?q=Imperial+Stout",
    "styles": "/beer/styles/",
    "top-rated": "/beer/top-rated/",
    "detail": "/beer/profile/147/1160/",
    "forums": "/community/",
    "places": "/place/",
    "login": "/community/login/",
    "review-form": "/beer/rate/1160/"
  },
  "deferred": {
    "submit-review": "The authenticated source submission terminal is unavailable because source-site review mutation was not performed."
  },
  "visual_excluded": {
    "home.desktop": "The direct source full-page raster is 1425 pixels wide because Edge omitted the scrollbar gutter from the frozen 1440-pixel viewport; a fresh anonymous 1440x1000 capture returned HTTP 403."
  },
  "prepare": [],
  "states": {
    "home.loaded": [],
    "beers.loaded": [],
    "search.results": [{"expect": "h1"}],
    "styles.loaded": [],
    "top-rated.loaded": [],
    "detail.loaded": [],
    "forums.loaded": [],
    "places.loaded": [],
    "login.loaded": [],
    "review-form.local-member-ready": {
      "session": "default",
      "steps": [{"expect": "form[action='/beer/rate/1160']"}]
    }
  },
  "session": {
    "post": "/community/login/local-test",
    "routes": ["review-form"],
    "expect_status": [303]
  },
  "boot": {
    "argv": ["{python}", "-m", "uvicorn", "app:app", "--host", "127.0.0.1", "--port", "{port}", "--log-level", "warning"],
    "cwd": "clone",
    "env": {
      "DATA_DIR": "{data_dir}",
      "TZ": "Etc/UTC",
      "WEBSITEBENCH_ENABLE_TEST_LOGIN": "1"
    }
  }
}
