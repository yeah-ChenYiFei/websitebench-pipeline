    {
      "id": "catalog-browse",
      "label": "Class catalog, category and subcategory browsing",
      "priority": "p0",
      "category": "content",
      "implementation_status": "implemented",
      "external_effect": "none",
      "journey_ids": [
        "browse-catalog",
        "class-detail"
      ],
      "invariant_ids": [
        "truncation-no-dead-links",
        "offline-closure"
      ],
      "entities": [
        {
          "name": "class",
          "identity": "class_id (slug from /classseries/single/<slug>)",
          "owner_scope": "global",
          "persistence": "durable"
        },
        {
          "name": "category",
          "identity": "category_slug",
          "owner_scope": "global",
          "persistence": "durable"
        },
        {
          "name": "subcategory",
          "identity": "(category_slug, subcategory_slug)",
          "owner_scope": "global",
          "persistence": "durable"
        },
        {
          "name": "instructor",
          "identity": "instructor_slug",
          "owner_scope": "global",
          "persistence": "durable"
        }
      ],
      "state_machine": {
        "states": [
          "listed",
          "detail",
          "boundary"
        ],
        "transitions": [
          {
            "from": "listed",
            "to": "detail",
            "trigger": "open-card-within-first-12"
          },
          {
            "from": "listed",
            "to": "boundary",
            "trigger": "open-card-beyond-first-12"
          }
        ],
        "kind": "idempotent-set"
      },
      "server_authorities": [
        "catalog-read"
      ],
      "proofs": {
        "evidence": {
          "valid": [
            "clone/tests/test_catalog.py::test_first_twelve_cards_reach_real_detail_pages"
          ],
          "invalid": [
            "clone/tests/test_catalog.py::test_no_card_resolves_to_404"
          ],
          "duplicate": [
            "clone/tests/test_catalog.py::test_class_in_multiple_subcategories_resolves_once"
          ]
        },
        "not_applicable": [
          {
            "obligation": "concurrency",
            "rationale": "Catalog is read-only at runtime; seeded at build time."
          },
          {
            "obligation": "migration",
            "rationale": "Covered at the database level."
          },
          {
            "obligation": "restart",
            "rationale": "Catalog is static seed data; restart persistence is a database-level obligation."
          },
          {
            "obligation": "foreign-owner",
            "rationale": "Catalog rows have no per-account owner."
          },
          {
            "obligation": "unauthorized-role",
            "rationale": "Catalog is public; no role gate applies."
          },
          {
            "obligation": "stale",
            "rationale": "Catalog rows do not expire."
          }
        ]
      }
    },
