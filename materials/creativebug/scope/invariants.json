        "clone/tests/test_invariants.py::test_revoked_session_rejected"
      ]
    },
    {
      "id": "registration-requires-verification",
      "priority": "p0",
      "journey_ids": [
        "register-and-onboard"
      ],
      "statement": "No signed-in account exists until the emailed six-digit code is verified; the pending state persists server-side and wrong, expired or reused codes are rejected.",
