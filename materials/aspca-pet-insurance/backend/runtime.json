{
  "database": {
    "data_dir": "data",
    "engine": "sqlite",
    "filename": "aspca-pet-insurance.sqlite3",
    "legacy_unbound_migration": false,
    "migration_hook": null,
    "seed_hook": null
  },
  "deployment": {
    "profiles": {
      "cloudflare-review": {
        "mail_adapter": "redis-resend",
        "payment_adapter": "local-sandbox",
        "persistence": "ephemeral-reset"
      },
      "docker-volume": {
        "mail_adapter": "effects-gateway",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent-volume"
      },
      "offline-harbor": {
        "mail_adapter": "local-outbox",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent"
      }
    }
  },
  "mail": {
    "enabled": true,
    "purposes": {
      "policy-confirmation": {
        "body": "Policy ${policy_number} for ${pet_name} was activated with a simulated ${frequency} payment of ${amount} ${currency}.",
        "expiry": "This local simulation has no external billing effect.",
        "footer": "ASPCA Pet Health Insurance offline clone — no real email or payment was sent.",
        "lead": "Your local ASPCA Pet Health Insurance enrollment is complete.",
        "required_variables": [
          "policy_number",
          "pet_name",
          "frequency",
          "amount",
          "currency"
        ],
        "secret_variables": [],
        "subject": "Your ASPCA Pet Insurance sandbox enrollment",
        "template_id": "aspca-pet-insurance.policy-confirmation.v1"
      }
    },
    "sender": {
      "address_env": "RESEND_FROM_EMAIL",
      "display_name": "ASPCA Pet Health Insurance"
    }
  },
  "payments": {
    "currency": "USD",
    "default_adapter": "local-sandbox",
    "enabled": true,
    "local_sandbox": {
      "scenarios": [
        {
          "display_label": "Simulated approval",
          "id": "sandbox-approved",
          "outcome": "approved"
        },
        {
          "display_label": "Simulated decline",
          "id": "sandbox-declined",
          "outcome": "declined"
        },
        {
          "display_label": "Simulated retry",
          "id": "sandbox-retry",
          "outcome": "retryable"
        }
      ]
    },
    "stripe_test": null
  },
  "schema_version": "websitebench.site-backend-runtime.v1",
  "session": {
    "host_only": true,
    "http_only": true,
    "same_site": "Lax",
    "secure": true
  },
  "site": {
    "id": "aspca-pet-insurance",
    "label": "ASPCA Pet Health Insurance",
    "public_origin": "https://aspca-pet-insurance.website-bench.com"
  }
}
