{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "order-recon",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "timeout_ms": 25000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": [
      "https://crumblcookies.com",
      "https://crumbl.video",
      "https://ordering.crumbl.com",
      "https://olo.crumbl.com"
    ],
    "clone": [
      "http://127.0.0.1:8123",
      "http://127.0.0.1:8000"
    ]
  },
  "steps": [
    {
      "id": "order-open",
      "action": "goto",
      "path": "/order",
      "observations": [
        {"id": "order-route", "kind": "url_path", "expect": {"contains": "/order"}}
      ],
      "screenshot": true
    },
    {
      "id": "order-settle",
      "action": "wait",
      "milliseconds": 5000
    },
    {
      "id": "order-state",
      "action": "snapshot",
      "observations": [
        {"id": "order-visible", "kind": "visible", "selector": {"source": "main", "clone": "main"}}
      ],
      "screenshot": true
    }
  ]
}
