      "clone": "text=Creme Br\u00fbl\u00e9e Cookie"
     }
    },
    {
     "id": "profile-nutrition",
     "kind": "visible",
     "selector": {
      "source": "text=Nutrition",
      "clone": "text=Nutrition"
     }
    }
   ],
   "screenshot": true
  },
  {
   "id": "open-stores",
