{
  "schema_version": "offline-clone.routes.v1",
  "routes": [
    {"id": "home", "path": "/", "priority": "P0", "role": "anonymous", "states": ["default", "mobile-menu"]},
    {"id": "subscription-configure", "path": "/coffee-subscription/configure", "priority": "P0", "role": "anonymous", "states": ["tasting", "quantity", "review"]},
    {"id": "checkout", "path": "/checkout", "priority": "P0", "role": "anonymous", "states": ["empty-validation", "synthetic-filled", "declined", "retryable", "approved-local-only"]},
    {"id": "coffee", "path": "/coffee", "priority": "P1", "role": "anonymous", "states": ["populated", "filtered", "searched", "zero-result", "paginated"]},
    {"id": "coffee-detail", "path": "/coffee/{slug}", "priority": "P1", "role": "anonymous", "states": ["default", "added-to-cart"]},
    {"id": "cart", "path": "/cart", "priority": "P1", "role": "anonymous", "states": ["empty", "populated"]},
    {"id": "account", "path": "/account", "priority": "P1", "role": "anonymous-or-local-account", "states": ["entry", "authenticated-dashboard"]},
    {"id": "account-register", "path": "/account/register", "priority": "P1", "role": "anonymous", "states": ["collecting", "local-verification", "authenticated"]},
    {"id": "account-signin", "path": "/account/signin", "priority": "P1", "role": "anonymous", "states": ["default", "invalid", "authenticated"]},
    {"id": "account-password-reset", "path": "/account/password-reset", "priority": "P1", "role": "anonymous", "states": ["collecting", "local-verification", "completed"]},
    {"id": "account-subscriptions", "path": "/account/subscriptions", "priority": "P1", "role": "local-account", "states": ["empty", "active", "paused", "cancelled", "reactivated", "skipped", "modified"]},
    {"id": "account-orders", "path": "/account/orders", "priority": "P1", "role": "local-account", "states": ["empty", "populated"]},
    {"id": "coffee-gifts", "path": "/coffee-gifts", "priority": "P2", "role": "anonymous", "states": ["default"]},
    {"id": "coffee-equipment", "path": "/coffee-equipment", "priority": "P2", "role": "anonymous", "states": ["default"]},
    {"id": "faq", "path": "/faq", "priority": "P2", "role": "anonymous", "states": ["default"]},
    {"id": "not-found", "path": "/{unknown}", "priority": "P1", "role": "anonymous", "states": ["not-found"]}
  ]
}
