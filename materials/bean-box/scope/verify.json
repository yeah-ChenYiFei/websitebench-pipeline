{
  "schema_version": "offline-clone.verify-driver.v1",
  "site_id": "bean-box",
  "boot": {
    "argv": ["{python}", "-m", "uvicorn", "app:app", "--host", "127.0.0.1", "--port", "{port}", "--log-level", "warning"],
    "cwd": "clone",
    "env": {"WEBSITEBENCH_BEAN_BOX_ADMIN_TOKEN": "bean-box-local-admin", "WEBSITEBENCH_SITE_BACKEND_RUNTIME": "backend/runtime.json", "WEBSITEBENCH_USE_SANDBOX_RUNTIME_MIRROR": "1", "WEBSITEBENCH_SITE_BACKEND_DATABASE": "{data_dir}/bean-box.sqlite3"}
  },
  "prepare": [],
  "routes": {
    "home": "/",
    "subscription": "/coffee-subscription/configure",
    "coffee": "/coffee",
    "checkout": "/checkout",
    "account": "/account",
    "register": "/account/register",
    "signin": "/account/signin",
    "password-reset": "/account/password-reset",
    "subscriptions": "/account/subscriptions",
    "orders": "/account/orders",
    "not-found": "/this-route-does-not-exist"
  },
  "states": {
    "home.loaded": [],
    "subscription.loaded": [],
    "coffee.loaded": [],
    "checkout.loaded": [],
    "account.loaded": [],
    "register.loaded": [],
    "signin.loaded": [],
    "password-reset.loaded": []
  },
  "status": {"not-found": 404},
  "deferred": {
    "source-checkout": "Unavailable because source cart/checkout mutation and payment are unauthorized.",
    "source-6-cup": "The current source exposes bag quantity; the clone's 6-cup control is explicitly labeled local trace compatibility.",
    "source-authenticated-account": "Source account behavior remains unavailable; implemented account behavior is candidate-only, site-isolated, synthetic @example.test expansion scope."
  }
}
