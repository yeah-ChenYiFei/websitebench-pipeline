{
  "schema_version": "websitebench.offline-clone.backend-semantic-suite.v1",
  "suite_id": "bean-box-local-business-boundaries",
  "allowed_origin": "http://127.0.0.1:8476",
  "timeout_seconds": 10,
  "follow_redirects": false,
  "invariants": [
    {
      "id": "actor-session-isolation",
      "applicability": "applicable",
      "required_polarities": ["positive", "negative"]
    },
    {
      "id": "payment-input-boundary",
      "applicability": "applicable",
      "required_polarities": ["positive", "negative"]
    },
    {
      "id": "json-type-boundary",
      "applicability": "applicable",
      "required_polarities": ["positive", "negative"]
    }
  ],
  "cases": [
    {
      "id": "session-owner-cart-mutation",
      "invariant_id": "actor-session-isolation",
      "polarity": "positive",
      "actor": "owner",
      "steps": [
        {
          "id": "establish-session",
          "request": {"method": "GET", "path": "/api/cart"},
          "expect": {"status": 200}
        },
        {
          "id": "add-with-server-session",
          "request": {"method": "POST", "path": "/api/cart/items", "json": {"coffee_id": 1}},
          "expect": {"status": 201, "json_equal": {"/cart_count": 1}}
        }
      ]
    },
    {
      "id": "foreign-owner-form-rejected",
      "invariant_id": "actor-session-isolation",
      "polarity": "negative",
      "actor": "foreign-owner",
      "steps": [
        {
          "id": "submit-foreign-owner",
          "request": {
            "method": "POST",
            "path": "/api/cart/items",
            "json": {"owner": "fixture-actor-foreign", "coffee_id": 1}
          },
          "expect": {"status": 403}
        }
      ]
    },
    {
      "id": "opaque-checkout-scenario-boundary",
      "invariant_id": "payment-input-boundary",
      "polarity": "positive",
      "actor": "checkout-owner",
      "steps": [
        {
          "id": "checkout-page",
          "request": {"method": "POST", "path": "/api/checkout/validate", "json": {"scenario_id": "sandbox-approved"}},
          "expect": {"status": 200, "json_equal": {"/adapter": "local-sandbox"}}
        }
      ]
    },
    {
      "id": "payment-field-alias-rejected",
      "invariant_id": "payment-input-boundary",
      "polarity": "negative",
      "actor": "checkout-attacker",
      "steps": [
        {
          "id": "unknown-pan-field",
          "request": {
            "method": "POST",
            "path": "/api/checkout/validate",
            "json": {"scenario_id": "sandbox-approved", "pan": "forbidden"}
          },
          "expect": {"status": 422}
        }
      ]
    },
    {
      "id": "integer-coffee-id-accepted",
      "invariant_id": "json-type-boundary",
      "polarity": "positive",
      "actor": "typed-owner",
      "steps": [
        {
          "id": "add-integer-id",
          "request": {"method": "POST", "path": "/api/cart/items", "json": {"coffee_id": 2}},
          "expect": {"status": 201, "json_equal": {"/cart_count": 1}}
        }
      ]
    },
    {
      "id": "boolean-coffee-id-rejected",
      "invariant_id": "json-type-boundary",
      "polarity": "negative",
      "actor": "type-confused-owner",
      "steps": [
        {
          "id": "reject-boolean-id",
          "request": {"method": "POST", "path": "/api/cart/items", "json": {"coffee_id": true}},
          "expect": {"status": 422}
        }
      ]
    }
  ]
}
