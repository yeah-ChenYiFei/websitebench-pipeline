{
  "schema_version": "websitebench.site-backend-runtime.v1",
  "site": {
    "id": "tripit",
    "label": "TripIt offline clone",
    "public_origin": "https://tripit.website-bench.com"
  },
  "database": {
    "engine": "sqlite",
    "data_dir": "runtime-data",
    "filename": "tripit.sqlite3",
    "migration_hook": null,
    "seed_hook": null,
    "legacy_unbound_migration": false
  },
  "session": {
    "host_only": true,
    "secure": true,
    "http_only": true,
    "same_site": "Lax"
  },
  "mail": {
    "sender": {
      "display_name": "TripIt",
      "address_env": "RESEND_FROM_EMAIL"
    },
    "purposes": {
      "registration": {
        "template_id": "tripit.registration.v1",
        "subject": "Verify your TripIt account",
        "lead": "Finish creating your TripIt account.",
        "body": "Your verification code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "This code is only for TripIt.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ]
      },
      "password-reset": {
        "template_id": "tripit.password-reset.v1",
        "subject": "Reset your TripIt password",
        "lead": "A password reset was requested for your TripIt account.",
        "body": "Your password reset code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "Ignore this message if you did not request a TripIt password reset.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ]
      },
      "share-invite": {
        "template_id": "tripit.share-invite.v1",
        "subject": "${inviter_name} shared the trip ${trip_name} with you",
        "lead": "You have been invited to a shared TripIt trip.",
        "body": "${inviter_name} added you to ${trip_name} as ${role}.",
        "expiry": "Open TripIt to view ${trip_name}.",
        "footer": "You are receiving this because your address was added to a shared trip.",
        "required_variables": [
          "inviter_name",
          "trip_name",
          "role"
        ],
        "secret_variables": []
      },
      "import-receipt": {
        "template_id": "tripit.import-receipt.v1",
        "subject": "Plans added to ${trip_name}",
        "lead": "TripIt processed a forwarded travel confirmation.",
        "body": "We added ${plan_count} plan(s) from ${provider} to ${trip_name}.",
        "expiry": "Forward more confirmations to keep ${trip_name} up to date.",
        "footer": "This receipt reflects only your TripIt itinerary.",
        "required_variables": [
          "trip_name",
          "plan_count",
          "provider"
        ],
        "secret_variables": []
      },
      "trip-update": {
        "template_id": "tripit.trip-update.v1",
        "subject": "Update for ${trip_name}",
        "lead": "A plan in your itinerary changed.",
        "body": "${change_summary}",
        "expiry": "Open ${trip_name} to review the current itinerary.",
        "footer": "You are receiving trip updates for a trip you own or share.",
        "required_variables": [
          "trip_name",
          "change_summary"
        ],
        "secret_variables": []
      },
      "pro-receipt": {
        "template_id": "tripit.pro-receipt.v1",
        "subject": "Your TripIt Pro receipt ${receipt_id}",
        "lead": "Thank you for subscribing to TripIt Pro.",
        "body": "Receipt ${receipt_id} totals ${total}.",
        "expiry": "No real charge was made in this offline clone.",
        "footer": "This receipt belongs only to your TripIt account.",
        "required_variables": [
          "receipt_id",
          "total"
        ],
        "secret_variables": []
      }
    }
  },
  "payments": {
    "default_adapter": "local-sandbox",
    "currency": "USD",
    "local_sandbox": {
      "scenarios": [
        {
          "id": "sandbox-pro-approved",
          "outcome": "approved",
          "display_label": "Simulated TripIt Pro approval"
        },
        {
          "id": "sandbox-pro-declined",
          "outcome": "declined",
          "display_label": "Simulated TripIt Pro decline"
        },
        {
          "id": "sandbox-pro-retryable",
          "outcome": "retryable",
          "display_label": "Simulated TripIt Pro retry"
        }
      ]
    },
    "stripe_test": {
      "public_origin": "https://tripit.website-bench.com",
      "return_path": "/pro/stripe-return",
      "webhook_path": "/api/stripe/webhook",
      "max_line_items": 1,
      "secret_key_env": "STRIPE_TEST_SECRET_KEY",
      "webhook_secret_env": "STRIPE_TEST_WEBHOOK_SECRET"
    }
  },
  "deployment": {
    "profiles": {
      "offline-harbor": {
        "persistence": "persistent",
        "mail_adapter": "local-outbox",
        "payment_adapter": "local-sandbox"
      },
      "cloudflare-review": {
        "persistence": "ephemeral-reset",
        "mail_adapter": "redis-resend",
        "payment_adapter": "stripe-test"
      },
      "docker-volume": {
        "persistence": "persistent-volume",
        "mail_adapter": "effects-gateway",
        "payment_adapter": "local-sandbox"
      }
    }
  }
}
