{
  "schema_version": "betterhelp.frontend-gate-samples.v1",
  "app_file": "clone/app.py",
  "app_attr": "APP",
  "module_name": "betterhelp_clone_app",
  "checks": [
    {"id": "home", "url": "/", "expect_status": 200, "expect_contains": ["You deserve to be happy.", "What type of therapy are you looking for?"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "get-started", "url": "/get-started/", "expect_status": 200, "expect_contains": ["Quiz progress 1 of 8", "Individual", "Couples", "Teen"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "get-started.state", "url": "/get-started/?skip_redirect_question=1", "expect_status": 200, "expect_contains": ["Which state are you in?", "Select State", "California", "Next"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "login", "url": "/login/", "expect_status": 200, "expect_contains": ["Log in", "Email Address", "Password"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "login.submit", "url": "/login/", "method": "post", "data": {"email": "alex.rivera@example.test", "password": "synthetic-pass-123"}, "expect_status": 401, "expect_contains": ["Credentials are invalid"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "signup", "url": "/signup/", "expect_status": 200, "expect_contains": ["Create your account", "synthetic email"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "about", "url": "/about/", "expect_status": 200, "expect_contains": ["About us", "Our therapists"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "faq", "url": "/faq/", "expect_status": 200, "expect_contains": ["Frequently asked questions", "How does BetterHelp work?"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "reviews", "url": "/reviews/", "expect_status": 200, "expect_contains": ["BetterHelp reviews", "Load More"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "advice", "url": "/advice/", "expect_status": 200, "expect_contains": ["Advice"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "therapists", "url": "/therapists/", "expect_status": 200, "expect_contains": ["Find a therapist"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "health", "url": "/health-data/", "expect_status": 200, "expect_contains": ["Health Data"], "expect_not_contains": ["NotImplementedError"], "session": false}
  ]
}
