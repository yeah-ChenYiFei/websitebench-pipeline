{
  "database": {
    "data_dir": "data",
    "engine": "sqlite",
    "filename": "betterhelp.sqlite3",
    "legacy_unbound_migration": false,
    "migration_hook": "backend.business:migrate_v4",
    "seed_hook": null
  },
  "deployment": {
    "profiles": {
      "cloudflare-review": {
        "mail_adapter": "redis-resend",
        "payment_adapter": "local-sandbox",
        "persistence": "ephemeral-reset"
      },
      "docker-volume": {
        "mail_adapter": "effects-gateway",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent-volume"
      },
      "offline-harbor": {
        "mail_adapter": "local-outbox",
        "payment_adapter": "local-sandbox",
        "persistence": "persistent"
      }
    }
  },
  "mail": {
    "purposes": {
      "password-reset": {
        "body": "Your password reset code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "Ignore this message if you did not contact BetterHelp.",
        "lead": "A password reset was requested for BetterHelp.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ],
        "subject": "Reset your BetterHelp password",
        "template_id": "betterhelp.password-reset.v1"
      },
      "registration": {
        "body": "Your verification code is ${code}.",
        "expiry": "This code expires in ${minutes} minutes.",
        "footer": "This code is only for BetterHelp.",
        "lead": "Finish creating your BetterHelp account.",
        "required_variables": [
          "code",
          "minutes"
        ],
        "secret_variables": [
          "code"
        ],
        "subject": "Verify your BetterHelp account",
        "template_id": "betterhelp.registration.v1"
      },
      "booking-confirmation": {
        "body": "Booking ${booking_id} with ${provider_name} is confirmed for ${starts_at}.",
        "expiry": "This confirmation is a local simulation.",
        "footer": "This is a local simulation; no email or appointment was sent.",
        "lead": "Your synthetic BetterHelp session is confirmed.",
        "required_variables": [
          "booking_id",
          "provider_name",
          "starts_at"
        ],
        "secret_variables": [],
        "subject": "Your BetterHelp session is confirmed",
        "template_id": "betterhelp.booking-confirmation.v1"
      }
    },
    "sender": {
      "address_env": "RESEND_FROM_EMAIL",
      "display_name": "BetterHelp"
    }
  },
  "payments": {
    "currency": "USD",
    "default_adapter": "local-sandbox",
    "local_sandbox": {
      "scenarios": [
        {
          "display_label": "Simulated approval",
          "id": "sandbox-approved",
          "outcome": "approved"
        },
        {
          "display_label": "Simulated decline",
          "id": "sandbox-declined",
          "outcome": "declined"
        },
        {
          "display_label": "Simulated retry",
          "id": "sandbox-retry",
          "outcome": "retryable"
        }
      ]
    },
    "stripe_test": null
  },
  "schema_version": "websitebench.site-backend-runtime.v1",
  "session": {
    "host_only": true,
    "http_only": true,
    "same_site": "Lax",
    "secure": true
  },
  "site": {
    "id": "betterhelp",
    "label": "BetterHelp",
    "public_origin": "https://betterhelp.website-bench.com"
  }
}
