            "from": "verified",
            "to": "account-created",
            "trigger": "transactional account creation and session rotation"
          },
          {
            "from": "pending-verification",
            "to": "expired",
            "trigger": "challenge expiry"
          },
          {
            "from": "pending-verification",
            "to": "locked",
            "trigger": "verification attempt budget exhausted"
          }
