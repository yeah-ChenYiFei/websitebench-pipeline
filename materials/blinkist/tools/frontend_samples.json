{
  "schema_version": "blinkist.frontend-gate-samples.v1",
  "app_file": "clone/app.py",
  "app_attr": "APP",
  "module_name": "blinkist_clone_app",
  "checks": [
    {"id": "for-you", "url": "/en/app/for-you", "expect_status": 200, "expect_contains": ["Masterclasses"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "search-atomic", "url": "/search?q=Atomic+Habits", "expect_status": 200, "expect_contains": ["Atomic Habits", "James Clear"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "book-detail", "url": "/app/books/atomic-habits-en", "expect_status": 200, "expect_contains": ["Atomic Habits"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "library", "url": "/app/library", "expect_status": 200, "expect_contains": ["My Library", "Your saved Blinks"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "register", "url": "/register", "expect_status": 200, "expect_contains": ["Create your Blinkist account", "Email"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "subscribe", "url": "/subscribe", "expect_status": 200, "expect_contains": ["Premium annual", "local sandbox"], "expect_not_contains": ["NotImplementedError"], "session": false},
    {"id": "health", "url": "/api/status", "expect_status": 200, "expect_contains": ["blinkist", "catalog_count"], "expect_not_contains": ["NotImplementedError"], "session": false}
  ]
}
