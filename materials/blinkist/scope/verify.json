{
  "schema_version": "offline-clone.verify-driver.v1",
  "site_id": "blinkist",
  "boot": {
    "argv": [
      "{python}",
      "app.py"
    ],
    "cwd": "clone",
    "env": {
      "WEBSITEBENCH_SITE_BACKEND_RUNTIME": "../backend/runtime.json",
      "WEBSITEBENCH_SITE_BACKEND_DATABASE": "{data_dir}/blinkist.sqlite3",
      "WEBSITEBENCH_LOCAL_HTTP_COOKIE": "1"
    }
  },
  "prepare": [],
  "routes": {
    "for-you": "/en/app/for-you",
    "explore": "/app/explore",
    "search": "/search?q=Atomic+Habits",
    "book-detail": "/app/books/atomic-habits",
    "library": "/app/library",
    "register": "/register",
    "verify": "/verify",
    "login": "/login",
    "subscribe": "/subscribe"
  },
  "states": {
    "for-you.default": [],
    "explore.populated": [],
    "search.results": [],
    "book-detail.default": [],
    "book-detail.favorite-success": [],
    "library.empty-or-populated": [],
    "auth.registration": [],
    "auth.email-verification": [],
    "auth.login": [],
    "subscription.local-sandbox": []
  },
  "deferred": {
    "source-authenticated-member": "Source member-state replay is unavailable without retaining credentials or browser session artifacts; candidate-local auth is covered by the site test suite.",
    "source-payment-mutation": "Real subscription, payment, and email delivery are unauthorized; the clone exposes only the declared local sandbox adapter."
  }
}
