{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-learner-expansion-public-recovery-en",
  "viewport": {"width": 1692, "height": 979},
  "timeout_ms": 45000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": [
      "https://www.coursera.org",
      "https://www.coursera.support",
      "https://d3njjcbhbojbot.cloudfront.net",
      "https://images.ctfassets.net",
      "https://coursera-course-photos.s3.amazonaws.com",
      "https://d15cw65ipctsrr.cloudfront.net",
      "https://s3.amazonaws.com",
      "https://coursera_assets.s3.amazonaws.com"
    ],
    "clone": ["http://127.0.0.1:8045"]
  },
  "steps": [
    {
      "id": "login-entry",
      "action": "goto",
      "path": "/login",
      "observations": [
        {"id": "login-route", "kind": "url_path"},
        {"id": "login-text", "kind": "text", "selector": "body"},
        {"id": "login-links", "kind": "count", "selector": "a"}
      ],
      "screenshot": true
    },
    {
      "id": "signup-entry",
      "action": "goto",
      "path": "/signup",
      "observations": [
        {"id": "signup-route", "kind": "url_path"},
        {"id": "signup-text", "kind": "text", "selector": "body"}
      ],
      "screenshot": true
    },
    {
      "id": "legacy-recovery-entry",
      "action": "goto",
      "path": "/account-recovery",
      "observations": [
        {"id": "legacy-recovery-route", "kind": "url_path"},
        {"id": "legacy-recovery-text", "kind": "text", "selector": "body"}
      ],
      "screenshot": true
    },
    {
      "id": "reset-password-entry",
      "action": "goto",
      "path": "/reset-password",
      "observations": [
        {"id": "reset-password-route", "kind": "url_path"},
        {"id": "reset-password-text", "kind": "text", "selector": "body"}
      ],
      "screenshot": true
    },
    {
      "id": "help-entry",
      "action": "goto",
      "path": "/help",
      "observations": [
        {"id": "help-route", "kind": "url_path"},
        {"id": "help-text", "kind": "text", "selector": "body"}
      ],
      "screenshot": true,
      "full_page": true
    },
    {
      "id": "contact-entry",
      "action": "goto",
      "path": "/about/contact",
      "observations": [
        {"id": "contact-route", "kind": "url_path"},
        {"id": "contact-text", "kind": "text", "selector": "body"}
      ],
      "screenshot": true,
      "full_page": true
    },
    {
      "id": "terms-entry",
      "action": "goto",
      "path": "/about/terms",
      "observations": [
        {"id": "terms-route", "kind": "url_path"},
        {"id": "terms-text", "kind": "text", "selector": "body"}
      ]
    },
    {
      "id": "privacy-entry",
      "action": "goto",
      "path": "/about/privacy",
      "observations": [
        {"id": "privacy-route", "kind": "url_path"},
        {"id": "privacy-text", "kind": "text", "selector": "body"}
      ]
    },
    {
      "id": "not-found-entry",
      "action": "goto",
      "path": "/websitebench-non-existent-coursera-deep-link",
      "observations": [
        {"id": "not-found-route", "kind": "url_path"},
        {"id": "not-found-text", "kind": "text", "selector": "body"}
      ],
      "screenshot": true
    }
  ]
}
