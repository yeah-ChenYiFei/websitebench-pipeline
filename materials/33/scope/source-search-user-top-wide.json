{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-source-search-user-top-wide",
  "viewport": {"width": 2559, "height": 1471},
  "timeout_ms": 30000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": [
      "https://www.coursera.org",
      "https://d3njjcbhbojbot.cloudfront.net",
      "https://coursera-course-photos.s3.amazonaws.com",
      "https://d15cw65ipctsrr.cloudfront.net",
      "https://s3.amazonaws.com",
      "https://coursera_assets.s3.amazonaws.com"
    ]
  },
  "steps": [
    {
      "id": "open-deep-learning-search-wide",
      "action": "goto",
      "path": "/search?query=Deep%20Learning",
      "observations": [
        {"id": "route", "kind": "url_path", "expect": {"equals": "/search"}},
        {"id": "title", "kind": "title"},
        {"id": "all-results", "kind": "count", "selector": "text=All Results"},
        {"id": "deep-learning-links", "kind": "count", "selector": "a:has-text('Deep Learning')"}
      ]
    },
    {
      "id": "wait-for-public-content",
      "action": "wait",
      "milliseconds": 6000
    },
    {
      "id": "capture-wide-search",
      "action": "snapshot",
      "observations": [
        {"id": "main-copy", "kind": "text", "selector": "main"},
        {"id": "all-results-settled", "kind": "count", "selector": "text=All Results"}
      ],
      "screenshot": true,
      "full_page": false
    }
  ]
}
