{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-business-current",
  "viewport": {"width": 1692, "height": 979},
  "timeout_ms": 45000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": [
      "https://www.coursera.org",
      "https://d3njjcbhbojbot.cloudfront.net",
      "https://images.ctfassets.net",
      "https://coursera_assets.s3.amazonaws.com"
    ],
    "clone": ["http://127.0.0.1:8044"]
  },
  "steps": [
    {
      "id": "open-business",
      "action": "goto",
      "path": "/browse/business",
      "observations": [
        {"id": "route", "kind": "url_path", "expect": {"equals": "/browse/business"}},
        {"id": "title", "kind": "title"},
        {"id": "business-heading", "kind": "text", "selector": "h1"},
        {"id": "main-copy-initial", "kind": "text", "selector": "main"},
        {"id": "main-links-initial", "kind": "count", "selector": "main a"},
        {"id": "main-images-initial", "kind": "count", "selector": "main img"}
      ],
      "screenshot": true,
      "full_page": false
    },
    {"id": "wait-initial", "action": "wait", "milliseconds": 1500},
    {"id": "scroll-1", "action": "press", "selector": "body", "key": "PageDown"},
    {"id": "wait-1", "action": "wait", "milliseconds": 1000},
    {"id": "scroll-2", "action": "press", "selector": "body", "key": "PageDown"},
    {"id": "wait-2", "action": "wait", "milliseconds": 1000},
    {
      "id": "capture-settled",
      "action": "snapshot",
      "observations": [
        {"id": "main-copy", "kind": "text", "selector": "main"},
        {"id": "most-popular", "kind": "count", "selector": "text='Most popular'"},
        {"id": "free-trial", "kind": "count", "selector": "text='Free Trial'"},
        {"id": "preview", "kind": "count", "selector": "text='Preview'"},
        {"id": "explore-roles", "kind": "count", "selector": "text='Explore roles'"},
        {"id": "faq", "kind": "count", "selector": "text='Frequently asked questions'"},
        {"id": "google-project-management-href", "kind": "attribute", "selector": "a:has-text('Google Project Management') >> nth=0", "attribute": "href"},
        {"id": "foundations-project-management-href", "kind": "attribute", "selector": "a:has-text('Foundations of Project Management') >> nth=0", "attribute": "href"},
        {"id": "ai-for-everyone-href", "kind": "attribute", "selector": "a:has-text('AI For Everyone') >> nth=0", "attribute": "href"},
        {"id": "key-technologies-href", "kind": "attribute", "selector": "a:has-text('Key Technologies for Business') >> nth=0", "attribute": "href"},
        {"id": "main-links", "kind": "count", "selector": "main a"},
        {"id": "main-images", "kind": "count", "selector": "main img"}
      ],
      "screenshot": true,
      "full_page": true
    }
  ]
}
