{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-clone-search-filter-panel",
  "viewport": {"width": 1191, "height": 979},
  "timeout_ms": 30000,
  "source_mutations_authorized": false,
  "allowed_origins": {"clone": ["http://127.0.0.1:8044"]},
  "steps": [
    {"id": "open-deep-learning-search", "action": "goto", "path": "/search?query=Deep%20Learning"},
    {"id": "open-filter-sort", "action": "click", "selector": "#search-filter-open"},
    {
      "id": "capture-filter-sort",
      "action": "snapshot",
      "observations": [
        {"id": "drawer", "kind": "count", "selector": "#search-filter-drawer:target", "expect": {"equals": 1}},
        {"id": "best-match", "kind": "count", "selector": "input[value='best-match']:checked", "expect": {"equals": 1}},
        {"id": "newest", "kind": "count", "selector": "text=Newest", "expect": {"equals": 1}},
        {"id": "view", "kind": "count", "selector": "button:has-text('View')", "expect": {"equals": 1}},
        {"id": "clear-all-disabled", "kind": "count", "selector": "button:has-text('Clear all'):disabled", "expect": {"equals": 1}}
      ],
      "screenshot": true,
      "full_page": false
    }
  ]
}
