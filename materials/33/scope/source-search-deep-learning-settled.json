{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-source-search-deep-learning-settled",
  "viewport": {"width": 1191, "height": 979},
  "timeout_ms": 30000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": [
      "https://www.coursera.org",
      "https://d3njjcbhbojbot.cloudfront.net",
      "https://coursera-course-photos.s3.amazonaws.com",
      "https://d15cw65ipctsrr.cloudfront.net",
      "https://s3.amazonaws.com",
      "https://coursera_assets.s3.amazonaws.com"
    ]
  },
  "steps": [
    {
      "id": "open-deep-learning-search",
      "action": "goto",
      "path": "/search?query=Deep%20Learning",
      "observations": [
        {"id": "route", "kind": "url_path", "expect": {"equals": "/search"}}
      ]
    },
    {
      "id": "wait-for-anonymous-dynamic-content",
      "action": "wait",
      "milliseconds": 6000
    },
    {
      "id": "capture-settled-search",
      "action": "snapshot",
      "observations": [
        {"id": "main-copy", "kind": "text", "selector": "main"},
        {"id": "all-results-count", "kind": "count", "selector": "text=All Results", "expect": {"equals": 1}},
        {"id": "deep-learning-link-count", "kind": "count", "selector": "a:has-text('Deep Learning')"}
      ],
      "screenshot": true,
      "full_page": true
    }
  ]
}
