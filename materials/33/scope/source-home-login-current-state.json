{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-home-login-current-state",
  "viewport": {"width": 1692, "height": 979},
  "timeout_ms": 45000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": [
      "https://www.coursera.org",
      "https://d3njjcbhbojbot.cloudfront.net",
      "https://images.ctfassets.net",
      "https://coursera_assets.s3.amazonaws.com",
      "https://accounts.google.com"
    ],
    "clone": ["http://127.0.0.1:8044"]
  },
  "steps": [
    {
      "id": "open-home",
      "action": "goto",
      "path": "/",
      "observations": [
        {"id": "home-route", "kind": "url_path"},
        {"id": "home-text", "kind": "text", "selector": "body"}
      ],
      "screenshot": true,
      "full_page": true
    },
    {"id": "scroll-page-1", "action": "press", "selector": "body", "key": "PageDown"},
    {"id": "wait-page-1", "action": "wait", "milliseconds": 700},
    {"id": "scroll-page-2", "action": "press", "selector": "body", "key": "PageDown"},
    {"id": "wait-page-2", "action": "wait", "milliseconds": 700},
    {"id": "capture-page-2", "action": "snapshot", "screenshot": true},
    {"id": "scroll-page-3", "action": "press", "selector": "body", "key": "PageDown"},
    {"id": "wait-page-3", "action": "wait", "milliseconds": 700},
    {"id": "scroll-page-4", "action": "press", "selector": "body", "key": "PageDown"},
    {"id": "wait-page-4", "action": "wait", "milliseconds": 700},
    {"id": "capture-page-4", "action": "snapshot", "screenshot": true},
    {"id": "scroll-page-5", "action": "press", "selector": "body", "key": "PageDown"},
    {"id": "wait-page-5", "action": "wait", "milliseconds": 700},
    {"id": "scroll-page-6", "action": "press", "selector": "body", "key": "PageDown"},
    {"id": "wait-page-6", "action": "wait", "milliseconds": 700},
    {"id": "capture-page-6", "action": "snapshot", "screenshot": true},
    {"id": "scroll-page-7", "action": "press", "selector": "body", "key": "PageDown"},
    {"id": "wait-page-7", "action": "wait", "milliseconds": 700},
    {
      "id": "capture-loaded-home",
      "action": "snapshot",
      "observations": [
        {"id": "new-popular-heading", "kind": "count", "selector": "text='New and popular'"},
        {"id": "career-heading", "kind": "count", "selector": "text='Get job-ready for an in-demand career'"},
        {"id": "partners-heading", "kind": "count", "selector": "text='Learn from 350+ leading universities and companies'"},
        {"id": "categories-heading", "kind": "count", "selector": "text='Explore categories'"},
        {"id": "trending-heading", "kind": "count", "selector": "text='Trending searches'"},
        {"id": "ai-heading", "kind": "count", "selector": "text='Learn AI skills from leading names'"},
        {"id": "purpose-heading", "kind": "count", "selector": "text='What brings you to Coursera today?'"},
        {"id": "outcome-heading", "kind": "count", "selector": "text='91% of learners achieved a positive career outcome'"},
        {"id": "testimonials-heading", "kind": "count", "selector": "text='Why people choose Coursera'"},
        {"id": "faq-heading", "kind": "count", "selector": "text='Frequently asked questions'"}
      ],
      "screenshot": true,
      "full_page": true
    },
    {"id": "return-home-top", "action": "press", "selector": "body", "key": "Home"},
    {"id": "wait-home-top", "action": "wait", "milliseconds": 700},
    {
      "id": "click-header-login",
      "action": "click",
      "selector": ":is(a, button):has-text('Log In') >> nth=0"
    },
    {
      "id": "wait-for-login-surface",
      "action": "wait",
      "milliseconds": 2500
    },
    {
      "id": "capture-home-login",
      "action": "snapshot",
      "observations": [
        {"id": "login-route", "kind": "url_path"},
        {"id": "login-text", "kind": "text", "selector": "body"},
        {"id": "dialogs", "kind": "count", "selector": "[role='dialog']"},
        {"id": "iframes", "kind": "count", "selector": "iframe"},
        {"id": "email-fields", "kind": "count", "selector": "input[type='email']"},
        {"id": "password-fields", "kind": "count", "selector": "input[type='password']"}
      ],
      "screenshot": true
    }
  ]
}
