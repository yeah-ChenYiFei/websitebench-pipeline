{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-business-category-audit",
  "viewport": {"width": 1692, "height": 979},
  "timeout_ms": 45000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": [
      "https://www.coursera.org",
      "https://d3njjcbhbojbot.cloudfront.net",
      "https://images.ctfassets.net",
      "https://coursera_assets.s3.amazonaws.com"
    ],
    "clone": ["http://127.0.0.1:8045"]
  },
  "steps": [
    {
      "id": "open-business",
      "action": "goto",
      "path": "/browse/business",
      "observations": [
        {"id": "route", "kind": "url_path", "expect": {"equals": "/browse/business"}},
        {"id": "title", "kind": "title"},
        {"id": "main-text", "kind": "text", "selector": "main"},
        {"id": "hero-text", "kind": "text", "selector": "main h1"},
        {"id": "main-heading-count", "kind": "count", "selector": "main h2"},
        {"id": "main-link-count", "kind": "count", "selector": "main a"},
        {"id": "main-image-count", "kind": "count", "selector": "main img"},
        {"id": "role-count-initial", "kind": "count", "selector": "text=Explore roles"},
        {"id": "faq-count-initial", "kind": "count", "selector": "h2:has-text('Frequently asked questions')"}
      ],
      "screenshot": true,
      "full_page": false
    },
    {"id": "wait-initial", "action": "wait", "milliseconds": 1500},
    {"id": "scroll-1", "action": "press", "selector": "body", "key": "PageDown", "screenshot": true},
    {"id": "wait-1", "action": "wait", "milliseconds": 1000},
    {"id": "scroll-2", "action": "press", "selector": "body", "key": "PageDown", "screenshot": true},
    {"id": "wait-2", "action": "wait", "milliseconds": 1000},
    {
      "id": "capture-settled",
      "action": "snapshot",
      "observations": [
        {"id": "main-text-settled", "kind": "text", "selector": "main"},
        {"id": "hero-heading", "kind": "text", "selector": "main h1"},
        {"id": "popular-heading", "kind": "text", "selector": "main h2 >> nth=0"},
        {"id": "roles-heading", "kind": "text", "selector": "main h2 >> nth=1"},
        {"id": "faq-heading", "kind": "text", "selector": "main h2 >> nth=2"},
        {"id": "popular-count", "kind": "count", "selector": "text=Most popular"},
        {"id": "role-count", "kind": "count", "selector": "h2:has-text('Explore roles')"},
        {"id": "faq-count", "kind": "count", "selector": "h2:has-text('Frequently asked questions')"},
        {"id": "faq-question-count", "kind": "count", "selector": "main details"},
        {"id": "role-empty-count", "kind": "count", "selector": "text=No results found for"},
        {"id": "main-link-count-settled", "kind": "count", "selector": "main a"},
        {"id": "main-image-count-settled", "kind": "count", "selector": "main img"},
        {"id": "image-0-src", "kind": "attribute", "selector": "main img >> nth=0", "attribute": "src"},
        {"id": "image-1-src", "kind": "attribute", "selector": "main img >> nth=1", "attribute": "src"},
        {"id": "image-2-src", "kind": "attribute", "selector": "main img >> nth=2", "attribute": "src"},
        {"id": "image-3-src", "kind": "attribute", "selector": "main img >> nth=3", "attribute": "src"},
        {"id": "image-4-src", "kind": "attribute", "selector": "main img >> nth=4", "attribute": "src"},
        {"id": "image-5-src", "kind": "attribute", "selector": "main img >> nth=5", "attribute": "src"},
        {"id": "image-6-src", "kind": "attribute", "selector": "main img >> nth=6", "attribute": "src"},
        {"id": "image-7-src", "kind": "attribute", "selector": "main img >> nth=7", "attribute": "src"},
        {"id": "google-project-management-href", "kind": "attribute", "selector": "a:has-text('Google Project Management') >> nth=0", "attribute": "href"},
        {"id": "foundations-project-management-href", "kind": "attribute", "selector": "a:has-text('Foundations of Project Management') >> nth=0", "attribute": "href"},
        {"id": "ai-for-everyone-href", "kind": "attribute", "selector": "a:has-text('AI For Everyone') >> nth=0", "attribute": "href"},
        {"id": "key-technologies-href", "kind": "attribute", "selector": "a:has-text('Key Technologies for Business') >> nth=0", "attribute": "href"}
      ],
      "screenshot": true,
      "full_page": true
    }
  ]
}
