{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-business-faq-visual-audit",
  "viewport": {"width": 1692, "height": 979},
  "timeout_ms": 45000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": [
      "https://www.coursera.org",
      "https://d3njjcbhbojbot.cloudfront.net",
      "https://images.ctfassets.net",
      "https://coursera_assets.s3.amazonaws.com"
    ],
    "clone": ["http://127.0.0.1:8045"]
  },
  "steps": [
    {"id": "open-business", "action": "goto", "path": "/browse/business"},
    {"id": "wait-initial", "action": "wait", "milliseconds": 1500},
    {"id": "show-all", "action": "click", "selector": "button:has-text('Show all 7 frequently asked questions')"},
    {"id": "open-q2", "action": "click", "selector": "button:has-text('Do I need prior business experience to take courses on Coursera?')", "screenshot": true},
    {"id": "open-q3", "action": "click", "selector": "button:has-text('What careers can I pursue by taking business courses on Coursera?')", "screenshot": true},
    {"id": "open-q4", "action": "click", "selector": "button:has-text('Are business courses on Coursera recognized by employers?')", "screenshot": true},
    {"id": "open-q5", "action": "click", "selector": "button:has-text('How do business courses on Coursera compare to traditional MBA programs?')", "screenshot": true},
    {"id": "open-q6", "action": "click", "selector": "button:has-text('Does Coursera offer business courses for free?')", "screenshot": true},
    {"id": "open-q7", "action": "click", "selector": "button:has-text('What types of business programs does Coursera offer?')", "screenshot": true}
  ]
}
