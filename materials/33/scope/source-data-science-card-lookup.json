{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-source-data-science-card-lookup",
  "viewport": {"width": 1264, "height": 1312},
  "timeout_ms": 30000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": ["https://www.coursera.org"]
  },
  "steps": [
    {
      "id": "open-data-science",
      "action": "goto",
      "path": "/browse/data-science",
      "observations": [
        {"id": "business-consultants-count", "kind": "count", "selector": "a:has-text('Generative AI for Business Consultants')"},
        {"id": "prompting-count", "kind": "count", "selector": "a:has-text('Discover the Art of Prompting')"},
        {"id": "ibm-fundamentals-count", "kind": "count", "selector": "a:has-text('Generative AI Fundamentals')"},
        {"id": "pittsburgh-count", "kind": "count", "selector": "a:has-text('University of Pittsburgh')"},
        {"id": "leeds-count", "kind": "count", "selector": "a:has-text('University of Leeds')"}
      ],
      "screenshot": true,
      "full_page": true
    },
    {
      "id": "search-business-consultants",
      "action": "goto",
      "path": "/search?query=Generative%20AI%20for%20Business%20Consultants",
      "observations": [
        {"id": "business-consultants-count", "kind": "count", "selector": "a:has-text('Generative AI for Business Consultants')"},
        {"id": "business-consultants-main", "kind": "text", "selector": "main"}
      ]
    },
    {
      "id": "search-prompting",
      "action": "goto",
      "path": "/search?query=Discover%20the%20Art%20of%20Prompting",
      "observations": [
        {"id": "prompting-count", "kind": "count", "selector": "a:has-text('Discover the Art of Prompting')"},
        {"id": "prompting-main", "kind": "text", "selector": "main"}
      ]
    },
    {
      "id": "search-ibm-fundamentals",
      "action": "goto",
      "path": "/search?query=Generative%20AI%20Fundamentals%20IBM",
      "observations": [
        {"id": "ibm-fundamentals-count", "kind": "count", "selector": "a:has-text('Generative AI Fundamentals')"},
        {"id": "ibm-fundamentals-main", "kind": "text", "selector": "main"}
      ]
    },
    {
      "id": "search-pittsburgh-degree",
      "action": "goto",
      "path": "/search?query=University%20of%20Pittsburgh%20degree",
      "observations": [
        {"id": "pittsburgh-count", "kind": "count", "selector": "a:has-text('University of Pittsburgh')"},
        {"id": "pittsburgh-main", "kind": "text", "selector": "main"}
      ]
    },
    {
      "id": "search-leeds-degree",
      "action": "goto",
      "path": "/search?query=University%20of%20Leeds%20degree",
      "observations": [
        {"id": "leeds-count", "kind": "count", "selector": "a:has-text('University of Leeds')"},
        {"id": "leeds-main", "kind": "text", "selector": "main"}
      ]
    }
  ]
}
