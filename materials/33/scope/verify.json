{
  "schema_version": "offline-clone.verify-driver.v1",
  "site_id": "33",
  "note": "Frozen Task 2 diagnostic aliases and state recipes. Authenticated source evidence was unavailable; authenticated candidate states use deterministic clone-local fixtures only.",
  "boot": {
    "argv": ["{python}", "-m", "uvicorn", "app:app", "--host", "127.0.0.1", "--port", "{port}", "--log-level", "warning"],
    "cwd": "clone",
    "env": {}
  },
  "prepare": [],
  "session": {
    "token_env": "WEBSITEBENCH_VERIFY_SESSION_TOKEN",
    "post": "/__websitebench/session",
    "headers": {
      "X-WebsiteBench-Verify-Token": "{{token}}"
    },
    "expect_status": [204],
    "accounts": {
      "empty-learner": {
        "form": {
          "account": "empty-learner"
        },
        "routes": ["checkout"]
      },
      "progress-learner": {
        "form": {
          "account": "progress-learner"
        },
        "routes": ["my-learning", "lesson", "quiz", "account-history", "preferences"]
      }
    }
  },
  "routes": {
    "home": "/",
    "browse": "/browse",
    "subject-arts-and-humanities": "/browse/arts-and-humanities",
    "subject-business": "/browse/business",
    "subject-computer-science": "/browse/computer-science",
    "subject-data-science": "/browse/data-science",
    "subject-health": "/browse/health",
    "subject-information-technology": "/browse/information-technology",
    "subject-language-learning": "/browse/language-learning",
    "subject-math-and-logic": "/browse/math-and-logic",
    "subject-personal-development": "/browse/personal-development",
    "subject-physical-science-and-engineering": "/browse/physical-science-and-engineering",
    "subject-social-sciences": "/browse/social-sciences",
    "search": "/search",
    "specialization": "/specializations/deep-learning",
    "course": "/learn/neural-networks-deep-learning",
    "login": "/login",
    "signup": "/signup",
    "password-recovery": "/account-recovery",
    "my-learning": "/my-learning",
    "lesson": "/learn/neural-networks-deep-learning/lesson/lesson-optimization",
    "quiz": "/learn/neural-networks-deep-learning/lesson/lesson-optimization",
    "account-history": "/account/history",
    "preferences": "/account/preferences",
    "checkout": "/checkout/deep-learning",
    "payments-checkout": "/payments/checkout",
    "help": "/help",
    "support": "/about/contact",
    "not-found": "/websitebench-nonexistent-route"
  },
  "status": {"not-found": 404},
  "states": {
    "home.loaded": [{"expect": "body"}],
    "browse.loaded": [{"expect": "body"}],
    "search.results": [{"goto": "/search"}, {"expect": "body"}],
    "search.no-results": [{"goto": "/search?q=zzzz-no-match-websitebench"}, {"expect": "body"}],
    "specialization.loaded": [{"expect": "body"}],
    "course.loaded": [{"expect": "body"}],
    "course.preview": [{"goto": "/learn/neural-networks-deep-learning/preview"}, {"expect": "body"}],
    "login.loaded": [{"expect": "body"}],
    "signup.loaded": [{"expect": "body"}],
    "password-recovery.loaded": [{"expect": "body"}],
    "my-learning.progress": {
      "session": "progress-learner",
      "steps": [
        {"expect": "h1:has-text(\"我的学习\")"},
        {"expect": "[data-enrollment-id]"},
        {"expect": "a[data-resume-lesson]"}
      ]
    },
    "lesson.opened": {
      "session": "progress-learner",
      "steps": [
        {"expect": "h1:has-text(\"Optimization methods\")"},
        {"expect": "form[action=\"/learning/quizzes/quiz-improving-networks\"]"}
      ]
    },
    "quiz.feedback": {
      "session": "progress-learner",
      "steps": [
        {"click": "input[name=\"answer\"][value=\"Regularization\"]"},
        {"click": "form[action=\"/learning/quizzes/quiz-improving-networks\"] button[type=\"submit\"]"},
        {"expect": "h1:has-text(\"测验得分：100\")"},
        {"expect": "p:has-text(\"Correct: regularization\")"}
      ]
    },
    "account-history.seeded": {
      "session": "progress-learner",
      "steps": [
        {"expect": "h1:has-text(\"报名历史\")"},
        {"expect": ".enrollment-card:has-text(\"进行中\")"}
      ]
    },
    "checkout.validation": {
      "session": "empty-learner",
      "steps": [
        {"eval": "document.querySelector('input[name=\"plan_id\"]').value='unsupported-plan'"},
        {"click": "form[action=\"/checkout/deep-learning\"] button[type=\"submit\"]"},
        {"expect": "h1:has-text(\"Checkout could not continue\")"},
        {"expect": "p:has-text(\"plan is unavailable\")"}
      ]
    },
    "checkout.review": {
      "session": "empty-learner",
      "steps": [
        {"click": "form[action=\"/checkout/deep-learning\"] button[type=\"submit\"]"},
        {"expect": "h1:has-text(\"付款方式\")"},
        {"expect": "#synthetic-card-number:not([name])"},
        {"click": "form[action$=\"/review\"] button[type=\"submit\"]"},
        {"expect": "h1:has-text(\"确认免费试用\")"},
        {"expect": "input[name=\"scenario_id\"][value=\"sandbox-approved\"]"},
        {"expect": ".checkout-total:has-text(\"今日合计：¥0\")"}
      ]
    },
    "help.loaded": [{"expect": "body"}],
    "support.loaded": [{"expect": "body"}],
    "not-found.loaded": [{"expect": "body"}]
  },
  "deferred": {},
  "states_out_of_scope": {
    "source-authenticated": "No logged-in source browser context was supplied; source-only authenticated state remains unavailable.",
    "source-payment": "No source mutation or payment action was authorized.",
    "source-password-recovery-submit": "No source recovery message was authorized."
  }
}
