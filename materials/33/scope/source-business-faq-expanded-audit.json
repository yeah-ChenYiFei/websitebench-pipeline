{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-business-faq-expanded-audit",
  "viewport": {"width": 1692, "height": 979},
  "timeout_ms": 45000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": [
      "https://www.coursera.org",
      "https://d3njjcbhbojbot.cloudfront.net",
      "https://images.ctfassets.net",
      "https://coursera_assets.s3.amazonaws.com"
    ],
    "clone": ["http://127.0.0.1:8045"]
  },
  "steps": [
    {"id": "open-business", "action": "goto", "path": "/browse/business"},
    {"id": "wait-initial", "action": "wait", "milliseconds": 1500},
    {
      "id": "open-first-question",
      "action": "click",
      "selector": "button:has-text('What skills can I develop with business courses on Coursera?')",
      "observations": [
        {"id": "first-question-block", "kind": "text", "selector": "button:has-text('What skills can I develop with business courses on Coursera?') >> xpath=../.."}
      ],
      "screenshot": true
    },
    {
      "id": "show-all",
      "action": "click",
      "selector": "button:has-text('Show all 7 frequently asked questions')",
      "observations": [
        {"id": "faq-region-text", "kind": "text", "selector": "h2:has-text('Frequently asked questions') >> xpath=../.."},
        {"id": "faq-region-button-count", "kind": "count", "selector": "h2:has-text('Frequently asked questions') >> xpath=../.. >> button"},
        {"id": "faq-region-link-count", "kind": "count", "selector": "h2:has-text('Frequently asked questions') >> xpath=../.. >> a"}
      ],
      "screenshot": true,
      "full_page": false
    }
  ]
}
