{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-clone-data-science-category",
  "viewport": {"width": 1191, "height": 979},
  "timeout_ms": 20000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": ["https://www.coursera.org"],
    "clone": ["http://127.0.0.1:8044"]
  },
  "steps": [
    {
      "id": "open-data-science",
      "action": "goto",
      "path": "/browse/data-science",
      "observations": [
        {"id": "canonical-route", "kind": "url_path", "expect": {"equals": "/browse/data-science"}},
        {"id": "heading", "kind": "text", "selector": "#ds-heading", "expect": {"equals": "Data Science"}}
      ]
    },
    {
      "id": "capture-complete-category",
      "action": "snapshot",
      "observations": [
        {"id": "result-card-count", "kind": "count", "selector": ".ds-result-card", "expect": {"equals": 12}},
        {"id": "release-card-count", "kind": "count", "selector": "[data-source-release-card]", "expect": {"equals": 4}},
        {"id": "trending-card-count", "kind": "count", "selector": ".ds-trending .ds-card", "expect": {"equals": 4}},
        {"id": "trending-first-title", "kind": "text", "selector": ".ds-trending .ds-card:first-child h3", "expect": {"equals": "Introduction to AI"}},
        {"id": "trending-last-title", "kind": "text", "selector": ".ds-trending .ds-card:last-child h3", "expect": {"equals": "Generative AI Fundamentals"}},
        {"id": "deep-learning-heading", "kind": "text", "selector": "#ds-deep-learning-heading", "expect": {"equals": "Enhance Your Deep Learning Skills with Neural Networks"}},
        {"id": "deep-learning-card-count", "kind": "count", "selector": "[data-source-deep-learning-card]", "expect": {"equals": 4}},
        {"id": "conflicting-core-collection-count", "kind": "count", "selector": ".ds-core-collection", "expect": {"equals": 0}},
        {"id": "degree-card-count", "kind": "count", "selector": ".ds-degrees .ds-card", "expect": {"equals": 4}},
        {"id": "degree-first-provider", "kind": "text", "selector": ".ds-degrees .ds-card:first-child .ds-provider", "expect": {"equals": "Northeastern University"}},
        {"id": "degree-last-provider", "kind": "text", "selector": ".ds-degrees .ds-card:last-child .ds-provider", "expect": {"equals": "University of Leeds"}},
        {"id": "faq-heading", "kind": "text", "selector": "#ds-faq-heading", "expect": {"equals": "Frequently asked questions"}},
        {"id": "leading-partners-heading", "kind": "text", "selector": "#ds-partners-heading", "expect": {"equals": "Leading partners"}}
      ],
      "screenshot": true,
      "full_page": true
    }
  ]
}
