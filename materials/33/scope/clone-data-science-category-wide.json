{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-clone-data-science-category-wide",
  "viewport": {"width": 1264, "height": 1312},
  "timeout_ms": 20000,
  "source_mutations_authorized": false,
  "allowed_origins": {"clone": ["http://127.0.0.1:8044"]},
  "steps": [
    {
      "id": "open-data-science",
      "action": "goto",
      "path": "/browse/data-science",
      "observations": [
        {"id": "route", "kind": "url_path", "expect": {"equals": "/browse/data-science"}},
        {"id": "heading", "kind": "text", "selector": "#ds-heading", "expect": {"equals": "Data Science"}}
      ]
    },
    {
      "id": "capture-wide-category",
      "action": "snapshot",
      "observations": [
        {"id": "trending-card-count", "kind": "count", "selector": ".ds-trending .ds-card", "expect": {"equals": 4}},
        {"id": "degree-card-count", "kind": "count", "selector": ".ds-degrees .ds-card", "expect": {"equals": 4}},
        {"id": "trending-business-title", "kind": "text", "selector": ".ds-trending .ds-card:nth-child(2) h3", "expect": {"equals": "Generative AI for Business Consultants"}},
        {"id": "degree-pittsburgh-provider", "kind": "text", "selector": ".ds-degrees .ds-card:nth-child(3) .ds-provider", "expect": {"equals": "University of Pittsburgh"}}
      ],
      "screenshot": true,
      "full_page": true
    }
  ]
}
