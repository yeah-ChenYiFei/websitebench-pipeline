{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-clone-browse-source-lower-sections",
  "viewport": {
    "width": 1191,
    "height": 979
  },
  "timeout_ms": 15000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": ["https://www.coursera.org"],
    "clone": ["http://127.0.0.1:8044"]
  },
  "steps": [
    {
      "id": "open-browse",
      "action": "goto",
      "path": "/browse",
      "observations": [
        {
          "id": "browse-route",
          "kind": "url_path",
          "expect": {"equals": "/browse"}
        }
      ]
    },
    {
      "id": "capture-source-backed-lower-collections",
      "action": "snapshot",
      "observations": [
        {
          "id": "deep-learning-title",
          "kind": "text",
          "selector": "#source-deep-learning-heading",
          "expect": {"equals": "Enhance Your Deep Learning Skills with Neural Networks"}
        },
        {
          "id": "course-card-count",
          "kind": "count",
          "selector": ".source-lower-course-card",
          "expect": {"equals": 12}
        },
        {
          "id": "degree-card-count",
          "kind": "count",
          "selector": ".source-lower-degree-card",
          "expect": {"equals": 4}
        },
        {
          "id": "skill-count",
          "kind": "count",
          "selector": ".source-lower-skill-link",
          "expect": {"equals": 6}
        },
        {
          "id": "partner-count",
          "kind": "count",
          "selector": ".source-lower-partner",
          "expect": {"equals": 8}
        },
        {
          "id": "leading-partners-title",
          "kind": "text",
          "selector": "#source-partners-heading",
          "expect": {"equals": "Leading partners"}
        }
      ],
      "screenshot": true,
      "full_page": true
    }
  ]
}
