{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-clone-search-deep-learning",
  "viewport": {"width": 1191, "height": 979},
  "timeout_ms": 30000,
  "source_mutations_authorized": false,
  "allowed_origins": {"clone": ["http://127.0.0.1:8044"]},
  "steps": [
    {
      "id": "open-deep-learning-search",
      "action": "goto",
      "path": "/search?query=Deep%20Learning",
      "observations": [
        {"id": "route", "kind": "url_path", "expect": {"equals": "/search"}},
        {"id": "title", "kind": "title", "expect": {"equals": "Coursera | Online Courses From Top Universities. Join for Free"}},
        {"id": "ai-overview", "kind": "count", "selector": "text=AI Overview", "expect": {"equals": 1}},
        {"id": "ai-answer", "kind": "count", "selector": "text=Understanding deep learning and how to get started", "expect": {"equals": 1}},
        {"id": "ai-starter-cards", "kind": "count", "selector": "[data-ai-starter-card='true']", "expect": {"equals": 4}},
        {"id": "result-count", "kind": "count", "selector": "[data-search-result='true']", "expect": {"equals": 12}},
        {"id": "assistant-count", "kind": "count", "selector": ".search-assistant-panel", "expect": {"equals": 0}},
        {"id": "assistant-composer-count", "kind": "count", "selector": ".search-assistant-composer", "expect": {"equals": 0}},
        {"id": "remote-images", "kind": "count", "selector": "img[src^='http']", "expect": {"equals": 0}}
      ]
    },
    {
      "id": "capture-complete-search",
      "action": "snapshot",
      "observations": [
        {"id": "all-results", "kind": "count", "selector": "text=All Results", "expect": {"equals": 1}},
        {"id": "interstitial", "kind": "count", "selector": "text=What brings you to Coursera today?", "expect": {"equals": 1}},
        {"id": "loaded-covers", "kind": "count", "selector": ".search-result-cover img", "expect": {"equals": 12}}
      ],
      "screenshot": true,
      "full_page": true
    }
  ]
}
