{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-clone-search-user-top",
  "viewport": {"width": 2559, "height": 1471},
  "timeout_ms": 30000,
  "source_mutations_authorized": false,
  "allowed_origins": {"clone": ["http://127.0.0.1:8044"]},
  "steps": [
    {
      "id": "open-user-selected-search-state",
      "action": "goto",
      "path": "/search?query=Deep%20Learning",
      "observations": [
        {"id": "ai-answer", "kind": "count", "selector": "text=Understanding deep learning and how to get started", "expect": {"equals": 1}},
        {"id": "starter-cards", "kind": "count", "selector": "[data-ai-starter-card='true']", "expect": {"equals": 4}},
        {"id": "assistant-composer", "kind": "count", "selector": ".search-assistant-composer", "expect": {"equals": 0}}
      ]
    },
    {
      "id": "capture-user-selected-top",
      "action": "snapshot",
      "observations": [
        {"id": "all-results", "kind": "count", "selector": "text=All Results", "expect": {"equals": 1}}
      ],
      "screenshot": true,
      "full_page": false
    }
  ]
}
