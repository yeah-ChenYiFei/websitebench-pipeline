{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-source-data-science-card-links",
  "viewport": {"width": 1264, "height": 1312},
  "timeout_ms": 30000,
  "source_mutations_authorized": false,
  "allowed_origins": {"source": ["https://www.coursera.org"]},
  "steps": [
    {
      "id": "business-consultants",
      "action": "goto",
      "path": "/search?query=Generative%20AI%20for%20Business%20Consultants",
      "observations": [
        {"id": "card-text", "kind": "text", "selector": "a:has-text('Generative AI for Business Consultants') >> nth=0"},
        {"id": "card-href", "kind": "attribute", "selector": "a:has-text('Generative AI for Business Consultants') >> nth=0", "attribute": "href"}
      ]
    },
    {
      "id": "prompting",
      "action": "goto",
      "path": "/search?query=Discover%20the%20Art%20of%20Prompting",
      "observations": [
        {"id": "card-text", "kind": "text", "selector": "a:has-text('Discover the Art of Prompting') >> nth=0"},
        {"id": "card-href", "kind": "attribute", "selector": "a:has-text('Discover the Art of Prompting') >> nth=0", "attribute": "href"}
      ]
    },
    {
      "id": "ibm-fundamentals",
      "action": "goto",
      "path": "/search?query=Generative%20AI%20Fundamentals%20IBM",
      "observations": [
        {"id": "card-text", "kind": "text", "selector": "a:has-text('Generative AI Fundamentals') >> nth=0"},
        {"id": "card-href", "kind": "attribute", "selector": "a:has-text('Generative AI Fundamentals') >> nth=0", "attribute": "href"}
      ]
    },
    {
      "id": "pittsburgh-degree",
