      ]
    },
    {
      "id": "leeds-degree",
      "action": "goto",
      "path": "/search?query=University%20of%20Leeds%20degree",
      "observations": [
        {"id": "card-text", "kind": "text", "selector": "a[href*='leeds'] >> nth=0"},
        {"id": "card-href", "kind": "attribute", "selector": "a[href*='leeds'] >> nth=0", "attribute": "href"}
      ]
    }
  ]
}
