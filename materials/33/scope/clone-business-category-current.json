{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-business-current",
  "viewport": {"width": 1692, "height": 979},
  "timeout_ms": 20000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": ["https://www.coursera.org"],
    "clone": ["http://127.0.0.1:8045"]
  },
  "steps": [
    {
      "id": "open-business",
      "action": "goto",
      "path": "/browse/business",
      "observations": [
        {"id": "route", "kind": "url_path", "expect": {"equals": "/browse/business"}},
        {"id": "title", "kind": "title", "expect": {"equals": "Business Online Courses | Coursera"}},
        {"id": "heading", "kind": "text", "selector": "h1", "expect": {"equals": "Business"}},
        {"id": "snapshot-marker", "kind": "count", "selector": "html[data-websitebench-snapshot='business-2026-08-19-233413']", "expect": {"equals": 1}},
        {"id": "product-card-count", "kind": "count", "selector": ".cds-ProductCard-base", "expect": {"equals": 34}},
        {"id": "image-count", "kind": "count", "selector": "img", "expect": {"equals": 90}},
        {"id": "script-count", "kind": "count", "selector": "script", "expect": {"equals": 0}},
        {"id": "remote-image-count", "kind": "count", "selector": "img[src^='http']", "expect": {"equals": 0}}
      ],
      "screenshot": true,
      "full_page": false
    },
    {
      "id": "capture-settled",
      "action": "snapshot",
      "observations": [
        {"id": "main-copy", "kind": "text", "selector": "main"},
        {"id": "most-popular-count", "kind": "count", "selector": "h2:has-text('Most popular')", "expect": {"equals": 1}},
        {"id": "explore-roles-count", "kind": "count", "selector": "h2:has-text('Explore roles')", "expect": {"equals": 1}},
        {"id": "trending-count", "kind": "count", "selector": "h2:has-text('Trending now')", "expect": {"equals": 1}},
        {"id": "core-skills-count", "kind": "count", "selector": "h2:has-text('Core skills')", "expect": {"equals": 1}},
        {"id": "neural-network-count", "kind": "count", "selector": "h2:has-text('Dive into Neural Networks')", "expect": {"equals": 1}},
        {"id": "online-degrees-count", "kind": "count", "selector": "h2:has-text('Online degrees')", "expect": {"equals": 1}},
        {"id": "all-results-count", "kind": "count", "selector": "h2:has-text('All results')", "expect": {"equals": 1}},
        {"id": "new-releases-count", "kind": "count", "selector": "h2:has-text('New releases')", "expect": {"equals": 1}},
        {"id": "survey-count", "kind": "count", "selector": "h2:has-text('What brings you to Coursera today?')", "expect": {"equals": 1}},
        {"id": "leading-partners-count", "kind": "count", "selector": "h2:has-text('Leading partners')", "expect": {"equals": 1}},
        {"id": "faq-count", "kind": "count", "selector": "h2:has-text('Frequently asked questions')", "expect": {"equals": 1}},
        {"id": "scrum-master-count", "kind": "count", "selector": "h3:has-text('Scrum Master')", "expect": {"equals": 1}},
        {"id": "claude-skills-count", "kind": "count", "selector": "h3:has-text('Claude Skills: Automating Business Workflows')", "expect": {"equals": 1}}
      ],
      "screenshot": true,
      "full_page": true
    }
  ]
}
