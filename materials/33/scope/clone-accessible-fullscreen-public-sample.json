{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "coursera-accessible-fullscreen-clone-sample",
  "viewport": {"width": 1692, "height": 979},
  "timeout_ms": 20000,
  "source_mutations_authorized": false,
  "allowed_origins": {"clone": ["http://127.0.0.1:8044"]},
  "steps": [
    {"id": "business", "action": "goto", "path": "/browse/business", "observations": [{"id": "business-route", "kind": "url_path", "expect": {"equals": "/browse/business"}}, {"id": "business-text", "kind": "text", "selector": "body"}], "screenshot": true, "full_page": true},
    {"id": "specialization", "action": "goto", "path": "/specializations/deep-learning", "observations": [{"id": "specialization-route", "kind": "url_path"}], "screenshot": true},
    {"id": "login", "action": "goto", "path": "/login", "observations": [{"id": "login-text", "kind": "text", "selector": "body"}], "screenshot": true},
    {"id": "signup", "action": "goto", "path": "/signup", "observations": [{"id": "signup-text", "kind": "text", "selector": "body"}], "screenshot": true},
    {"id": "contact", "action": "goto", "path": "/about/contact", "observations": [{"id": "contact-text", "kind": "text", "selector": "body"}], "screenshot": true, "full_page": true},
    {"id": "not-found", "action": "goto", "path": "/websitebench-non-existent-coursera-deep-link", "observations": [{"id": "not-found-text", "kind": "text", "selector": "body"}], "screenshot": true}
  ]
}
