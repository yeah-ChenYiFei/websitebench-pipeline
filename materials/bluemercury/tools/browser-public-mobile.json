{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "bluemercury-public-get-mobile",
  "viewport": {"width": 390, "height": 844},
  "timeout_ms": 20000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": ["https://bluemercury.com", "https://cdn.shopify.com"],
    "clone": ["http://127.0.0.1:8765"]
  },
  "steps": [
    {"id": "home", "action": "goto", "path": "/", "observations": [{"id": "home-route", "kind": "url_path", "expect": {"equals": "/"}}], "screenshot": true},
    {"id": "home-main", "action": "snapshot", "observations": [{"id": "home-main-visible", "kind": "visible", "selector": {"source": "main", "clone": "main"}, "expect": {"equals": true}}]},
    {"id": "home-settle", "action": "wait", "milliseconds": 1500, "screenshot": true},
    {"id": "skincare", "action": "goto", "path": "/collections/skin-care", "observations": [{"id": "skincare-route", "kind": "url_path", "expect": {"equals": "/collections/skin-care"}}], "screenshot": true},
    {"id": "skincare-main", "action": "snapshot", "observations": [{"id": "skincare-main-visible", "kind": "visible", "selector": {"source": "main", "clone": "main"}, "expect": {"equals": true}}]},
    {"id": "skincare-settle", "action": "wait", "milliseconds": 1500, "screenshot": true},
    {"id": "search-zero", "action": "goto", "path": "/search?q=wb-no-match-781&type=product", "observations": [{"id": "search-route", "kind": "url_path", "expect": {"equals": "/search"}}], "screenshot": true},
    {"id": "search-main", "action": "snapshot", "observations": [{"id": "search-main-visible", "kind": "visible", "selector": {"source": "main", "clone": "main"}, "expect": {"equals": true}}]},
    {"id": "search-settle", "action": "wait", "milliseconds": 1500, "screenshot": true},
    {"id": "product", "action": "goto", "path": "/products/skinceuticals-c-e-ferulic", "observations": [{"id": "product-route", "kind": "url_path", "expect": {"equals": "/products/skinceuticals-c-e-ferulic"}}], "screenshot": true},
    {"id": "product-main", "action": "snapshot", "observations": [{"id": "product-main-visible", "kind": "visible", "selector": {"source": "main", "clone": "main"}, "expect": {"equals": true}}]},
    {"id": "product-settle", "action": "wait", "milliseconds": 1500, "screenshot": true},
    {"id": "empty-cart", "action": "goto", "path": "/cart", "observations": [{"id": "cart-route", "kind": "url_path", "expect": {"equals": "/cart"}}], "screenshot": true},
    {"id": "cart-main", "action": "snapshot", "observations": [{"id": "cart-main-visible", "kind": "visible", "selector": {"source": "main", "clone": "main"}, "expect": {"equals": true}}]},
    {"id": "cart-settle", "action": "wait", "milliseconds": 1500, "screenshot": true}
  ]
}
