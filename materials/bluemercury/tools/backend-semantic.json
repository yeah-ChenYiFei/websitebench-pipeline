{
  "schema_version": "websitebench.offline-clone.backend-semantic-suite.v1",
  "suite_id": "bluemercury-local-runtime-boundaries",
  "allowed_origin": "http://127.0.0.1:8765",
  "timeout_seconds": 10,
  "follow_redirects": false,
  "invariants": [
    {
      "id": "LOCAL-RUNTIME-001",
      "applicability": "applicable",
      "required_polarities": ["positive", "negative"]
    }
  ],
  "cases": [
    {
      "id": "local-reset-and-health",
      "invariant_id": "LOCAL-RUNTIME-001",
      "polarity": "positive",
      "actor": "local-operator",
      "steps": [
        {"id": "reset", "request": {"method": "POST", "path": "/__admin/reset", "headers": {"X-WebsiteBench-Confirm-Site": "bluemercury"}, "headers_env": {"X-WebsiteBench-Admin-Token": "BLUEMERCURY_ADMIN_RESET_TOKEN"}}, "expect": {"status": 200, "json_equal": {"/status": "ok"}}},
        {"id": "health", "request": {"method": "GET", "path": "/__websitebench/health"}, "expect": {"status": 200, "json_equal": {"/status": "ok"}}}
      ]
    },
    {
      "id": "foreign-order-fails-closed",
      "invariant_id": "LOCAL-RUNTIME-001",
      "polarity": "negative",
      "actor": "foreign-shopper",
      "steps": [
        {"id": "reset-without-authorization", "request": {"method": "POST", "path": "/__admin/reset"}, "expect": {"status": 403}},
        {"id": "unknown-order", "request": {"method": "GET", "path": "/orders/BM-FOREIGN-ORDER"}, "expect": {"status": 404}}
      ]
    }
  ]
}
