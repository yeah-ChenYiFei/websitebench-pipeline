{
  "schema_version": "websitebench.offline-clone.browser-scenario.v1",
  "scenario_id": "autotrader-p1-stateful-desktop",
  "viewport": {"width": 1440, "height": 900},
  "timeout_ms": 15000,
  "source_mutations_authorized": false,
  "allowed_origins": {
    "source": ["https://www.autotrader.co.uk"],
    "clone": ["http://127.0.0.1:18891"]
  },
  "steps": [
    {"id":"register","action":"goto","path":"/secure/register"},
    {"id":"name","action":"fill","selector":"#reg input[name=name]","value":"State Driver"},
    {"id":"email","action":"fill","selector":"#reg input[name=email]","value":"state.driver@example.test"},
    {"id":"password","action":"fill","selector":"#reg input[name=password]","value_env":"AUTOTRADER_TEST_PASSWORD"},
    {"id":"terms","action":"check","selector":"#reg input[type=checkbox]"},
    {"id":"start","action":"click","selector":"#reg button"},
    {"id":"verify-visible","action":"wait","selector":"#verify:not([hidden])"},
    {"id":"inbox","action":"click","selector":"#open-inbox"},
    {"id":"verify","action":"click","selector":"#verify button:last-of-type"},
    {"id":"account","action":"wait","selector":"text=Welcome back, State Driver"},
    {"id":"search","action":"goto","path":"/cars/used?make=Ford&price=15000"},
    {"id":"save","action":"click","selector":"article.card:first-of-type [data-save]"},
    {"id":"saved","action":"wait","selector":"article.card:first-of-type button:has-text('Saved')"},
    {"id":"saved-page","action":"goto","path":"/cars/saved"},
    {"id":"saved-refresh","action":"snapshot","observations":[{"id":"saved-car","kind":"visible","selector":"text=2022 Ford Fiesta 1.0 EcoBoost","expect":{"equals":true}}],"screenshot":true},
    {"id":"detail","action":"goto","path":"/cars/used/listing/ford-fiesta"},
    {"id":"contact","action":"click","selector":"a[href='/contact-seller?car=ford-fiesta']"},
    {"id":"request-type","action":"select","selector":"select[name=request_type]","option":"test-drive"},
    {"id":"message","action":"fill","selector":"textarea[name=message]","value":"Please keep this request local."},
    {"id":"save-request","action":"click","selector":"#contact-seller-form button"},
    {"id":"request-saved","action":"wait","selector":"text=Request saved locally. No message was sent."},
    {"id":"sell","action":"goto","path":"/selling/find-car"},
    {"id":"make","action":"fill","selector":"#sell input[name=make]","value":"Volvo"},
    {"id":"year","action":"fill","selector":"#sell input[name=year]","value":"2021"},
    {"id":"mileage","action":"fill","selector":"#sell input[name=mileage]","value":"31000"},
    {"id":"price","action":"fill","selector":"#sell input[name=price]","value":"21995"},
    {"id":"review","action":"click","selector":"#sell button"},
    {"id":"submit","action":"click","selector":"#submit-listing"},
    {"id":"confirmed","action":"wait","selector":"text=Your advert has been submitted"},
    {"id":"history","action":"goto","path":"/account/history"},
    {"id":"edit","action":"click","selector":"article.listing-row:first-of-type a.secondary"},
    {"id":"edit-price","action":"fill","selector":"#edit-listing-form input[name=price]","value":"20995"},
    {"id":"save-edit","action":"click","selector":"#edit-listing-form button"},
    {"id":"detail-after-edit","action":"wait","selector":"text=£20,995"},
    {"id":"edited","action":"snapshot","observations":[{"id":"detail-path","kind":"url_path","expect":{"matches":"^/account/listings/AT-[0-9]+$"}},{"id":"updated-price","kind":"visible","selector":"text=£20,995","expect":{"equals":true}}],"screenshot":true}
  ]
}
