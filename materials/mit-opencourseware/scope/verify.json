    "external-boundary.branded-local-soft-404": [
      {
        "goto": "/external-boundary/"
      },
      {
        "expect": "[data-wb-component='external-boundary']"
      }
    ],
    "data-boundary.branded-retained-snapshot-boundary": [
      {
        "goto": "/data-boundary/"
      },
      {
        "expect": "[data-wb-capability='data-boundary']"
      }
    ],
    "not-found.default": [],
    "catalog.second-batch": [
      {
        "goto": "/search/?state=second-batch"
      },
      {
        "expect": "[data-wb-component='catalog-results']"
      }
    ],
    "catalog.filtered-math-199": [
      {
        "goto": "/search/?state=math"
      },
      {
        "expect": "[data-wb-control='catalog-math-filter']:checked"
      }
