        "expect": "[data-wb-component='catalog-error']"
      }
    ],
    "catalog.full-reload-recovers-default": [
      {
        "goto": "/search/?state=reload-recovered"
      },
      {
        "expect": "[data-wb-component='catalog-results']"
      }
    ],
    "catalog.resources-first-batch-10000-results": [
      {
        "goto": "/search/?state=resources"
      },
      {
        "expect": "[data-wb-control='catalog-resource-tab']:checked"
      }
    ],
    "home.all-home-carousels-second-batch": [
      {
        "goto": "/?state=carousel-second-batches"
