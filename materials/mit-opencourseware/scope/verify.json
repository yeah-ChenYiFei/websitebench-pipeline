    "catalog.sorted-course-number": [
      {
        "goto": "/search/?state=course-number"
      },
      {
        "expect": "[data-wb-control='catalog-sort']"
      }
    ],
    "catalog.empty-zero-results": [
      {
        "goto": "/search/?state=empty"
      },
      {
        "expect": "[data-wb-component='catalog-empty']"
      }
    ],
    "catalog.api-error": [
      {
        "goto": "/search/?state=error"
      },
      {
        "expect": "[data-wb-component='catalog-error']"
      }
    ],
    "catalog.successful-retry-retains-error-shell": [
      {
        "goto": "/search/?state=retry-stale"
      },
